---
import '../styles/global.css';
import { ui } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { studioPlace } from '../data/contact';
import { hourly } from '../data/pricing';

type JsonLdNode = Record<string, unknown>;

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative path for Open Graph / Twitter image */
  ogImage?: string;
  /** When true, emit homepage LocalBusiness JSON-LD */
  structuredData?: boolean;
  /** Extra schema.org nodes (Person, BreadcrumbList, …) */
  extraJsonLd?: JsonLdNode | JsonLdNode[];
  swapLogoAfterHero?: boolean;
  /** Home page: enable mobile app-shell (tabs) without affecting desktop */
  mobileApp?: boolean;
  /** Photographer gallery: hide top nav on scroll, keep album tabs */
  galleryPage?: boolean;
}

const {
  title,
  description,
  ogImage,
  structuredData = false,
  extraJsonLd,
  swapLogoAfterHero = false,
  mobileApp = false,
  galleryPage = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${ui.meta.siteTitle}` : ui.meta.siteTitle;
const pageDescription = description ?? ui.meta.siteDescription;
const ogTitle = title ? pageTitle : ui.meta.ogTitle;

const site = Astro.site ?? new URL('https://znimay.art');
const canonical = new URL(Astro.url.pathname, site).href;
const defaultOgPath = `${import.meta.env.BASE_URL}og.jpg`.replace(/\/{2,}/g, '/');
const ogImagePath = ogImage ?? defaultOgPath;
const ogImageUrl = ogImagePath.startsWith('http')
  ? ogImagePath
  : new URL(ogImagePath, site).href;
const isDefaultOg = !ogImage;

const base = import.meta.env.BASE_URL;

const homeUrl = new URL(base, site).href;
const extraNodes = extraJsonLd
  ? Array.isArray(extraJsonLd)
    ? extraJsonLd
    : [extraJsonLd]
  : [];

const localBusiness: JsonLdNode | null = structuredData
  ? {
      '@type': ['LocalBusiness', 'PhotographyBusiness'],
      name: 'ЗНІМАЙ',
      alternateName: 'ZNIMAY',
      description: ui.meta.siteDescription,
      url: homeUrl,
      image: ogImageUrl,
      priceRange: `від ${hourly.price} грн`,
      openingHours: `Mo-Su ${studioPlace.opens}-${studioPlace.closes}`,
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: [
          'Monday',
          'Tuesday',
          'Wednesday',
          'Thursday',
          'Friday',
          'Saturday',
          'Sunday',
        ],
        opens: studioPlace.opens,
        closes: studioPlace.closes,
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: studioPlace.street,
        addressLocality: studioPlace.city,
        addressRegion: studioPlace.region,
        addressCountry: studioPlace.country,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: studioPlace.lat,
        longitude: studioPlace.lng,
      },
      hasMap: studioPlace.mapsUrl,
      areaServed: {
        '@type': 'City',
        name: studioPlace.city,
      },
      sameAs: [
        'https://www.instagram.com/znimay_phstudio/',
        'https://t.me/znimay_bot',
      ],
      makesOffer: [
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Фотосесії під ключ',
            description: 'Сімейні, фешн, арт та бізнес фотосесії',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Відеозйомка',
            description: 'Зйомка відео будь-якого формату та супровід бізнесу',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Оренда фотостудії',
            description: 'Простора фотостудія в Черкасах',
          },
        },
      ],
    }
  : null;

const jsonLdGraph = [...(localBusiness ? [localBusiness] : []), ...extraNodes];
const jsonLd =
  jsonLdGraph.length === 0
    ? null
    : jsonLdGraph.length === 1
      ? { '@context': 'https://schema.org', ...jsonLdGraph[0] }
      : { '@context': 'https://schema.org', '@graph': jsonLdGraph };
---

<!doctype html>
<html
  lang="uk"
  data-mobile-app={mobileApp ? 'true' : undefined}
  data-gallery-page={galleryPage ? 'true' : undefined}
>
  <head>
    <meta charset="UTF-8" />
    {mobileApp && (
      <script is:inline>
        (function () {
          try {
            if (window.matchMedia('(max-width: 767px)').matches) {
              document.documentElement.setAttribute('data-mobile-app-active', 'true');
              var hash = location.hash || '';
              var onMenu =
                !hash ||
                hash === '#' ||
                hash === '#home' ||
                hash === '#hero';
              document.documentElement.setAttribute('data-menu-home', onMenu ? 'true' : 'false');
            }
          } catch (e) {}
        })();
      </script>
    )}
    <script is:inline>
      (function () {
        // Avoid mid-page landings: browser scroll restore + mandatory snap fight on load
        try {
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        } catch (e) {}
        if (!location.hash) {
          window.scrollTo(0, 0);
        }
        function enableSnap() {
          document.documentElement.classList.add('is-snap-ready');
        }
        if (document.readyState === 'complete') {
          requestAnimationFrame(enableSnap);
        } else {
          window.addEventListener('load', function () {
            requestAnimationFrame(enableSnap);
          });
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="ЗНІМАЙ" />
    <meta name="geo.region" content="UA-71" />
    <meta name="geo.placename" content={studioPlace.city} />
    <meta name="theme-color" content="#1a1214" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ЗНІМАЙ" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogTitle} />
    {isDefaultOg && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/jpeg" />
      </>
    )}
    <meta property="og:locale" content={ui.meta.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class:list={['min-h-screen flex flex-col', mobileApp && 'has-mobile-app']}>
    <Header swapLogoAfterHero={swapLogoAfterHero} mobileApp={mobileApp} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer hideOnMobileApp={mobileApp} />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
    <script>
      import { initMobileTabs } from '../lib/mobile-tabs';
      initMobileTabs();
    </script>
  </body>
</html>
