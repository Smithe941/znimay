---
import { t } from '../i18n/ui';
import { tourNodes, tourRooms } from '../data/spaces';
import I18nText from './I18nText.astro';

const uk = t('uk');
const en = t('en');
const base = import.meta.env.BASE_URL;

const rooms = tourRooms.map((room) => ({
  ...room,
  previewUrl: `${base}media/${room.preview}`,
}));

const nodesPayload = tourNodes.map((node) => ({
  id: node.id,
  room: node.room,
  panorama: `${base}media/${node.panorama}`,
  name: node.name,
  forwardLinks: node.links
    .filter((link) => link.kind === 'forward')
    .map((link) => ({
      nodeId: link.nodeId,
      name: link.name,
      position: link.position,
    })),
  wallLinks: node.links
    .filter((link) => link.kind === 'wall')
    .map((link) => ({
      nodeId: link.nodeId,
      name: link.name,
      position: link.position,
    })),
}));

const tourConfig = {
  startNodeId: 'room_1_1' as const,
  loadingTxt: { uk: uk.studio.panoLoading, en: en.studio.panoLoading },
  nodes: nodesPayload,
};

const mainTabs = [
  { id: 'tour', uk: uk.studio.tabTour, en: en.studio.tabTour },
  { id: 'locations', uk: uk.studio.tabLocations, en: en.studio.tabLocations },
] as const;
---

<div
  class="studio-spaces"
  data-studio-spaces
  data-tour-config={JSON.stringify(tourConfig)}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 md:px-8">
    <div class="reveal mb-5 sm:mb-6 md:mb-8">
      <div class="flex items-end justify-between gap-3 md:flex-col md:items-stretch md:gap-8">
        <h2 class="min-w-0 font-display text-[2.35rem] leading-none sm:text-4xl md:text-5xl">
          <I18nText uk={uk.studio.title} en={en.studio.title} />
        </h2>

        <div
          class="studio-main-nav flex shrink-0 gap-px overflow-hidden border border-ink/20 bg-ink/10 md:w-fit"
          role="tablist"
          aria-label={uk.studio.title}
          data-studio-main-tabs
        >
          {
            mainTabs.map((tab, index) => (
              <button
                type="button"
                role="tab"
                id={`studio-main-${tab.id}`}
                class="studio-main-tab cursor-pointer shrink-0 bg-surface px-3 py-2 text-[0.7rem] tracking-[0.14em] uppercase text-muted transition-colors hover:text-ink focus-visible:z-10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/30 focus-visible:ring-offset-2 focus-visible:ring-offset-surface sm:px-4 sm:py-2.5 sm:text-xs sm:tracking-[0.16em]"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`studio-panel-${tab.id}`}
                data-studio-main-tab={tab.id}
                data-active={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
              >
                <I18nText uk={tab.uk} en={tab.en} />
              </button>
            ))
          }
        </div>
      </div>

      <p class="mt-2 max-w-xl text-[0.95rem] leading-relaxed text-muted sm:mt-3 sm:text-base">
        <I18nText uk={uk.studio.subtitle} en={en.studio.subtitle} />
      </p>
    </div>
  </div>

  <!-- Panel: 3D Tour -->
  <div
    id="studio-panel-tour"
    role="tabpanel"
    aria-labelledby="studio-main-tour"
    data-studio-panel="tour"
    class="mt-1 sm:mt-2"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6 md:px-8">
      <div
        class="studio-room-nav -mx-4 border-y border-ink/10 sm:-mx-6 md:-mx-8"
        role="tablist"
        aria-label={uk.studio.roomsNav}
        data-room-tabs
      >
        <div class="scrollbar-none flex gap-1 overflow-x-auto px-4 py-3 sm:gap-2 sm:px-6 md:px-8">
          {
            rooms.map((room, index) => (
              <button
                type="button"
                role="tab"
                id={`space-tab-${room.id}`}
                class="studio-tab-link cursor-pointer shrink-0 px-3 py-2 text-xs tracking-[0.16em] uppercase text-muted transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls="studio-pano"
                data-space-tab
                data-room-id={room.id}
                data-start-node={room.startNodeId}
                data-active={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
              >
                <I18nText uk={room.label.uk} en={room.label.en} />
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mx-auto mt-4 max-w-6xl md:mt-5 md:px-8">
      <figure class="reveal studio-pano relative overflow-hidden bg-ink">
        <div
          id="studio-pano"
          class="h-[62svh] min-h-[280px] w-full touch-pan-y sm:h-[70vh] md:h-[min(78vh,720px)]"
          role="tabpanel"
          aria-labelledby="space-tab-room_1"
        >
        </div>
        <figcaption
          class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex items-end justify-between gap-3 bg-gradient-to-t from-ink/80 to-transparent px-4 pb-4 pt-16 sm:px-6"
        >
          <div>
            <p class="text-xs tracking-[0.14em] uppercase text-blush sm:text-sm" data-pano-name>
              <I18nText uk={nodesPayload[0].name.uk} en={nodesPayload[0].name.en} />
            </p>
            <p class="mt-1 text-[0.7rem] tracking-[0.12em] uppercase text-blush-soft/80 sm:text-xs">
              <I18nText uk={uk.studio.panoHint} en={en.studio.panoHint} />
            </p>
          </div>
        </figcaption>
      </figure>
    </div>
  </div>

  <!-- Panel: Locations -->
  <div
    id="studio-panel-locations"
    role="tabpanel"
    aria-labelledby="studio-main-locations"
    data-studio-panel="locations"
    class="mt-6 hidden sm:mt-8"
    hidden
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6 md:px-8">
      <p class="reveal mb-5 max-w-xl text-[0.95rem] leading-relaxed text-muted sm:mb-6 sm:text-base">
        <I18nText uk={uk.studio.locationsIntro} en={en.studio.locationsIntro} />
      </p>

      <div class="reveal" data-locations-carousel>
        <div
          class="locations-track scrollbar-none -mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto overscroll-x-contain px-4 pb-1 sm:-mx-6 sm:gap-4 sm:px-6 md:mx-0 md:gap-5 md:px-0"
          data-locations-track
          tabindex="0"
          aria-roledescription="carousel"
          aria-label={uk.studio.tabLocations}
        >
          {
            rooms.map((room, index) => (
              <article
                class="locations-slide relative w-[min(100%,28rem)] shrink-0 snap-center overflow-hidden bg-ink text-blush-soft sm:w-[min(100%,32rem)] md:w-[min(100%,36rem)]"
                data-locations-slide
                aria-roledescription="slide"
                aria-label={`${index + 1} / ${rooms.length}`}
              >
                <div class="relative aspect-[4/5] sm:aspect-[5/6] md:aspect-[4/5]">
                  <img
                    src={room.previewUrl}
                    alt={room.label.uk}
                    class="absolute inset-0 h-full w-full object-cover"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    draggable="false"
                  />
                  <div
                    class="absolute inset-0 bg-gradient-to-t from-ink via-ink/35 to-transparent"
                    aria-hidden="true"
                  />
                  <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6 md:p-7">
                    <p class="text-[0.65rem] tracking-[0.18em] uppercase text-blush/70">
                      {index + 1} / {rooms.length}
                    </p>
                    <h3 class="mt-2 font-display text-[1.85rem] leading-none tracking-wide text-blush sm:text-3xl md:text-4xl">
                      <I18nText uk={room.label.uk} en={room.label.en} />
                    </h3>
                    <p class="mt-2.5 max-w-sm text-[0.9rem] leading-snug text-blush-soft/85 sm:mt-3 sm:text-[0.95rem] sm:leading-relaxed">
                      <I18nText uk={room.blurb.uk} en={room.blurb.en} />
                    </p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <div class="mt-4 flex items-center justify-between gap-4 sm:mt-5">
          <div class="flex items-center gap-2" aria-label={uk.studio.tabLocations}>
            {
              rooms.map((room, index) => (
                <button
                  type="button"
                  class="locations-dot size-2 cursor-pointer rounded-full bg-ink/20 transition hover:bg-ink/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
                  data-locations-dot={index}
                  data-active={index === 0 ? 'true' : 'false'}
                  aria-label={room.label.uk}
                  aria-current={index === 0 ? 'true' : undefined}
                />
              ))
            }
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              class="flex size-11 cursor-pointer items-center justify-center border border-ink/20 text-ink transition hover:border-ink hover:bg-ink hover:text-blush focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-surface active:opacity-80"
              data-locations-prev
              aria-label={uk.studio.locationsPrev}
            >
              <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M10 3 5 8l5 5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <button
              type="button"
              class="flex size-11 cursor-pointer items-center justify-center border border-ink/20 text-ink transition hover:border-ink hover:bg-ink hover:text-blush focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-surface active:opacity-80"
              data-locations-next
              aria-label={uk.studio.locationsNext}
            >
              <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M6 3l5 5-5 5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .studio-main-tab[data-active='true'] {
    background: var(--color-ink);
    color: var(--color-blush);
  }

  .studio-tab-link[data-active='true'] {
    color: var(--color-ink);
  }

  .locations-dot[data-active='true'] {
    background: var(--color-ink);
    transform: scale(1.25);
  }

  .scrollbar-none {
    scrollbar-width: none;
  }

  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>

<style is:global>
  .studio-pano .psv-container {
    --psv-loader-color: #dfb4c4;
    background: #252223;
  }

  .studio-pano .psv-navbar {
    background: color-mix(in srgb, #252223 88%, transparent);
    backdrop-filter: blur(8px);
  }

  .studio-pano .psv-button {
    color: #dfb4c4;
  }

  .studio-pano .psv-button:hover {
    color: #e8c9d4;
  }

  .studio-pano .psv-loader-container {
    background: #252223;
  }

  .studio-pano .psv-virtual-tour-arrow {
    filter: drop-shadow(0 2px 10px rgb(37 34 35 / 50%));
  }

  .tour-wall-plaque {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0.55rem 0.85rem;
    border: 1px solid color-mix(in srgb, #dfb4c4 55%, transparent);
    background: rgb(37 34 35 / 88%);
    color: #dfb4c4;
    box-shadow: 0 8px 28px rgb(37 34 35 / 35%);
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .psv-marker:hover .tour-wall-plaque,
  .tour-wall-plaque:hover,
  .tour-wall-plaque:focus-visible {
    background: rgb(37 34 35 / 96%);
    border-color: #dfb4c4;
    outline: none;
  }

  .tour-wall-plaque__label {
    font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: nowrap;
  }

  .tour-wall-plaque__hint {
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, #dfb4c4 70%, white);
    opacity: 0.75;
  }

  .tour-debug-dot {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #dfb4c4;
    pointer-events: none;
    user-select: none;
  }

  .tour-debug-dot__point {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #dfb4c4;
    box-shadow: 0 0 0 1px rgb(37 34 35 / 80%);
  }

  .tour-debug-dot__label {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
    text-shadow: 0 1px 2px rgb(37 34 35 / 90%);
  }

  .tour-debug-pin {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .tour-debug-pin__point {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #fff;
    border: 2px solid #dfb4c4;
    box-shadow: 0 0 0 1px #252223;
  }

  .tour-debug-pin__label {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    color: #fff;
    background: rgb(37 34 35 / 88%);
    border: 1px solid #dfb4c4;
    padding: 0.15rem 0.35rem;
    white-space: nowrap;
  }
</style>

<script>
  import { Viewer } from '@photo-sphere-viewer/core';
  import { VirtualTourPlugin } from '@photo-sphere-viewer/virtual-tour-plugin';
  import { MarkersPlugin } from '@photo-sphere-viewer/markers-plugin';
  import '@photo-sphere-viewer/core/index.css';
  import '@photo-sphere-viewer/virtual-tour-plugin/index.css';
  import '@photo-sphere-viewer/markers-plugin/index.css';

  type Localized = { uk: string; en: string };

  type LinkPayload = {
    nodeId: string;
    name: Localized;
    position: { yaw: string; pitch: string };
  };

  type TourNodePayload = {
    id: string;
    room: string;
    panorama: string;
    name: Localized;
    forwardLinks: LinkPayload[];
    wallLinks: LinkPayload[];
  };

  type TourConfig = {
    startNodeId: string;
    loadingTxt: Localized;
    nodes: TourNodePayload[];
  };

  function currentLang(): 'uk' | 'en' {
    return document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'uk';
  }

  function loc(value: Localized | string) {
    if (typeof value === 'string') return value;
    return value[currentLang()];
  }

  const root = document.querySelector<HTMLElement>('[data-studio-spaces]');
  const el = document.getElementById('studio-pano');
  const nameEl = root?.querySelector<HTMLElement>('[data-pano-name]');
  const roomTabs = root
    ? Array.from(root.querySelectorAll<HTMLButtonElement>('[data-space-tab]'))
    : [];
  const mainTabs = root
    ? Array.from(root.querySelectorAll<HTMLButtonElement>('[data-studio-main-tab]'))
    : [];
  const panels = root
    ? Array.from(root.querySelectorAll<HTMLElement>('[data-studio-panel]'))
    : [];

  function escapeHtml(value: string) {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function wallPlaqueHtml(label: string) {
    return `
      <button type="button" class="tour-wall-plaque">
        <span class="tour-wall-plaque__label">${escapeHtml(label)}</span>
        <span class="tour-wall-plaque__hint">→</span>
      </button>
    `;
  }

  function toDeg(rad: number) {
    return (rad * 180) / Math.PI;
  }

  function formatDeg(value: number) {
    return `${Math.round(value)}deg`;
  }

  function debugDotHtml(yaw: number, pitch: number) {
    return `
      <div class="tour-debug-dot">
        <span class="tour-debug-dot__point"></span>
        <span class="tour-debug-dot__label">${yaw}/${pitch}</span>
      </div>
    `;
  }

  function debugPinHtml(yaw: string, pitch: string) {
    return `
      <div class="tour-debug-pin">
        <span class="tour-debug-pin__point"></span>
        <span class="tour-debug-pin__label">{ yaw: '${yaw}', pitch: '${pitch}' }</span>
      </div>
    `;
  }

  function buildDebugGridMarkers() {
    const list: Array<{
      id: string;
      position: { yaw: string; pitch: string };
      html: string;
      anchor: string;
      size: { width: number; height: number };
      zIndex: number;
      data: { debug: boolean };
    }> = [];

    for (let yaw = -180; yaw < 180; yaw += 15) {
      for (let pitch = -60; pitch <= 45; pitch += 10) {
        list.push({
          id: `debug-${yaw}-${pitch}`,
          position: { yaw: `${yaw}deg`, pitch: `${pitch}deg` },
          html: debugDotHtml(yaw, pitch),
          anchor: 'center center',
          size: { width: 48, height: 24 },
          zIndex: 1,
          data: { debug: true },
        });
      }
    }

    return list;
  }

  function setMainTab(tabId: string) {
    for (const tab of mainTabs) {
      const active = tab.dataset.studioMainTab === tabId;
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
      tab.setAttribute('data-active', active ? 'true' : 'false');
      tab.tabIndex = active ? 0 : -1;
    }

    for (const panel of panels) {
      const active = panel.dataset.studioPanel === tabId;
      panel.classList.toggle('hidden', !active);
      panel.hidden = !active;
    }

    // PSV needs a resize when the tour panel becomes visible again
    if (tabId === 'tour') {
      requestAnimationFrame(() => {
        window.dispatchEvent(new Event('resize'));
      });
    }
  }

  function wireTablist(
    tabs: HTMLButtonElement[],
    onActivate: (tab: HTMLButtonElement) => void,
  ) {
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => onActivate(tab));
    });

    const parent = tabs[0]?.closest('[role="tablist"]');
    parent?.addEventListener('keydown', (event) => {
      if (!(event instanceof KeyboardEvent)) return;
      if (!(event.target instanceof HTMLElement)) return;
      if (!tabs.includes(event.target as HTMLButtonElement)) return;

      const current = tabs.indexOf(event.target as HTMLButtonElement);
      if (current < 0) return;

      let next = current;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (current + 1) % tabs.length;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp')
        next = (current - 1 + tabs.length) % tabs.length;
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = tabs.length - 1;

      if (next !== current) {
        event.preventDefault();
        tabs[next].focus();
        tabs[next].click();
      }
    });
  }

  if (root) {
    wireTablist(mainTabs, (tab) => {
      const id = tab.dataset.studioMainTab;
      if (id) setMainTab(id);
    });

    const track = root.querySelector<HTMLElement>('[data-locations-track]');
    const slides = track
      ? Array.from(track.querySelectorAll<HTMLElement>('[data-locations-slide]'))
      : [];
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-locations-dot]'));
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-locations-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-locations-next]');
    let activeSlide = 0;

    function setActiveSlide(index: number) {
      activeSlide = Math.max(0, Math.min(index, slides.length - 1));
      dots.forEach((dot, i) => {
        const on = i === activeSlide;
        dot.dataset.active = String(on);
        if (on) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    }

    function goToSlide(index: number, behavior: ScrollBehavior = 'smooth') {
      const slide = slides[index];
      if (!track || !slide) return;
      const left = slide.offsetLeft - (track.clientWidth - slide.clientWidth) / 2;
      track.scrollTo({ left: Math.max(0, left), behavior });
      setActiveSlide(index);
    }

    prevBtn?.addEventListener('click', () => {
      goToSlide(activeSlide <= 0 ? slides.length - 1 : activeSlide - 1);
    });
    nextBtn?.addEventListener('click', () => {
      goToSlide(activeSlide >= slides.length - 1 ? 0 : activeSlide + 1);
    });
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.dataset.locationsDot);
        if (!Number.isNaN(index)) goToSlide(index);
      });
    });

    if (track && slides.length > 0) {
      let scrollTick = 0;
      track.addEventListener(
        'scroll',
        () => {
          window.clearTimeout(scrollTick);
          scrollTick = window.setTimeout(() => {
            const center = track.scrollLeft + track.clientWidth / 2;
            let nearest = 0;
            let best = Infinity;
            slides.forEach((slide, i) => {
              const mid = slide.offsetLeft + slide.clientWidth / 2;
              const dist = Math.abs(mid - center);
              if (dist < best) {
                best = dist;
                nearest = i;
              }
            });
            setActiveSlide(nearest);
          }, 60);
        },
        { passive: true },
      );

      track.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          goToSlide(activeSlide >= slides.length - 1 ? 0 : activeSlide + 1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          goToSlide(activeSlide <= 0 ? slides.length - 1 : activeSlide - 1);
        }
      });
    }
  }

  if (root && el) {
    const config = JSON.parse(root.dataset.tourConfig || '{}') as TourConfig;
    const isTouch = window.matchMedia('(pointer: coarse)').matches;
    const nodeById = new Map(config.nodes.map((node) => [node.id, node]));

    const tourNodesForPlugin = config.nodes.map((node) => ({
      id: node.id,
      name: loc(node.name),
      panorama: node.panorama,
      links: node.forwardLinks.map((link) => ({
        nodeId: link.nodeId,
        name: loc(link.name),
        position: link.position,
      })),
    }));

    const viewer = new Viewer({
      container: el,
      loadingTxt: loc(config.loadingTxt) || '',
      navbar: ['zoom', 'move', 'fullscreen'],
      defaultZoomLvl: isTouch ? 40 : 50,
      minFov: 30,
      maxFov: 90,
      touchmoveTwoFingers: isTouch,
      // Page scroll must pass through — never zoom or pitch on wheel
      mousewheel: false,
      mousewheelCtrlKey: false,
      mousemove: true,
      plugins: [
        MarkersPlugin.withConfig({}),
        VirtualTourPlugin.withConfig({
          dataMode: 'client',
          positionMode: 'manual',
          renderMode: '3d',
          startNodeId: config.startNodeId,
          preload: true,
          nodes: tourNodesForPlugin,
          transitionOptions: {
            showLoader: true,
            speed: '20rpm',
            effect: 'fade',
            rotation: true,
          },
          arrowStyle: {
            className: 'znimay-tour-arrow',
            style: {
              color: '#dfb4c4',
            },
          },
        }),
      ],
    });

    const tour = viewer.getPlugin(VirtualTourPlugin) as VirtualTourPlugin;
    const markers = viewer.getPlugin(MarkersPlugin) as MarkersPlugin;

    let lastClickPin: {
      id: string;
      position: { yaw: string; pitch: string };
      html: string;
      anchor: string;
      size: { width: number; height: number };
      zIndex: number;
      data: { debug: boolean; pin: boolean };
    } | null = null;
    let currentNodeId = config.startNodeId;

    const setActiveRoomTab = (roomId: string) => {
      for (const tab of roomTabs) {
        const active = tab.dataset.roomId === roomId;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.setAttribute('data-active', active ? 'true' : 'false');
        tab.tabIndex = active ? 0 : -1;
        if (active) {
          el.setAttribute('aria-labelledby', tab.id);
          // Scroll only the horizontal tab strip — never the page
          // (scrollIntoView would jump the landing to #studio on tour init)
          const strip = tab.parentElement;
          if (strip) {
            const left = tab.offsetLeft - (strip.clientWidth - tab.clientWidth) / 2;
            strip.scrollTo({ left: Math.max(0, left), behavior: 'smooth' });
          }
        }
      }
    };

    const syncMarkers = (nodeId: string) => {
      currentNodeId = nodeId;
      const node = nodeById.get(nodeId);
      const wall = (node?.wallLinks || []).map((link) => ({
        id: `wall-${nodeId}-${link.nodeId}`,
        position: link.position,
        html: wallPlaqueHtml(loc(link.name)),
        anchor: 'center center',
        size: { width: 150, height: 56 },
        zIndex: 20,
        data: { goto: link.nodeId },
        tooltip: loc(link.name),
      }));

      const debug = buildDebugGridMarkers();
      const pin = lastClickPin ? [lastClickPin] : [];
      markers.setMarkers([...debug, ...pin, ...wall]);
    };

    const goToNode = (nodeId: string) => {
      const current = tour.getCurrentNode();
      if (current?.id === nodeId) {
        const payload = nodeById.get(nodeId);
        if (payload) setActiveRoomTab(payload.room);
        return;
      }
      void tour.setCurrentNode(nodeId);
    };

    const setPanoName = (name: Localized | string | undefined) => {
      if (!nameEl || name == null || name === '') return;
      if (typeof name === 'string') {
        nameEl.textContent = name;
        return;
      }
      nameEl.innerHTML = `<span class="i18n-uk">${escapeHtml(name.uk)}</span><span class="i18n-en">${escapeHtml(name.en)}</span>`;
    };

    tour.addEventListener('node-changed', ({ node }) => {
      const payload = nodeById.get(node.id);
      if (payload) setActiveRoomTab(payload.room);
      setPanoName(payload?.name ?? node.name);
      lastClickPin = null;
      syncMarkers(node.id);
    });

    window.addEventListener('znimay:lang', () => {
      syncMarkers(currentNodeId);
    });

    markers.addEventListener('select-marker', ({ marker }) => {
      if (marker.data?.debug) return;
      const goto = marker.data?.goto as string | undefined;
      if (goto) {
        void tour.setCurrentNode(goto);
      }
    });

    viewer.addEventListener('click', ({ data }) => {
      if (data.rightclick) return;

      const yaw = formatDeg(toDeg(data.yaw));
      const pitch = formatDeg(toDeg(data.pitch));
      const snippet = `{ yaw: '${yaw}', pitch: '${pitch}' }`;

      lastClickPin = {
        id: 'debug-click-pin',
        position: { yaw, pitch },
        html: debugPinHtml(yaw, pitch),
        anchor: 'center bottom',
        size: { width: 210, height: 42 },
        zIndex: 30,
        data: { debug: true, pin: true },
      };

      syncMarkers(currentNodeId);
      void navigator.clipboard?.writeText(snippet).catch(() => {});
    });

    viewer.addEventListener(
      'ready',
      () => {
        const current = tour.getCurrentNode();
        if (current) syncMarkers(current.id);
      },
      { once: true },
    );

    wireTablist(roomTabs, (tab) => {
      const nodeId = tab.dataset.startNode;
      if (!nodeId) return;
      goToNode(nodeId);
    });

    window.addEventListener('znimay:lang', () => {
      const current = tour.getCurrentNode();
      if (current) {
        syncMarkers(current.id);
        const payload = nodeById.get(current.id);
        if (nameEl && payload) nameEl.textContent = loc(payload.name);
      }
    });
  }
</script>
