    order: -1;
  }
</style>

<script>
  import { Viewer } from '@photo-sphere-viewer/core';
  import { VirtualTourPlugin } from '@photo-sphere-viewer/virtual-tour-plugin';
  import { MarkersPlugin } from '@photo-sphere-viewer/markers-plugin';
  import { GyroscopePlugin } from '@photo-sphere-viewer/gyroscope-plugin';
  import '@photo-sphere-viewer/core/index.css';
  import '@photo-sphere-viewer/virtual-tour-plugin/index.css';
  import '@photo-sphere-viewer/markers-plugin/index.css';

  let tourGyroStart: (() => void) | undefined;
  let tourGyroStop: (() => void) | undefined;

  type LinkPayload = {
    nodeId: string;
    name: string;
    position: { yaw: string; pitch: string };
    arrow?: 'up' | 'down' | 'left' | 'right';
  };

  type TourNodePayload = {
    id: string;
    room: string;
    panorama: string;
    panoramaHq: string;
    name: string;
    view: { yaw: string; pitch: string };
    sphereCorrection?: { pan?: string; tilt?: string; roll?: string };
    forwardLinks: LinkPayload[];
    wallLinks: LinkPayload[];
  };

  type TourConfig = {
    startNodeId: string;
    loadingTxt: string;
    nodes: TourNodePayload[];
  };

  const root = document.querySelector<HTMLElement>('[data-studio-spaces]');
  const tourModal = (() => {
    const modal =
      root?.querySelector<HTMLElement>('[data-tour-modal]') ??
      document.querySelector<HTMLElement>('[data-tour-modal]');
    // Escape page-canvas stacking context so the modal sits above the fixed header
    if (modal && modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }
    return modal;
  })();
  const el = document.getElementById('studio-pano');
  const nameEl = tourModal?.querySelector<HTMLElement>('[data-pano-name]');
  const roomTabs = tourModal
    ? Array.from(tourModal.querySelectorAll<HTMLButtonElement>('[data-space-tab]'))
    : [];
  const mainTabs = root
    ? Array.from(root.querySelectorAll<HTMLButtonElement>('[data-studio-main-tab]'))
    : [];
  const panels = root
    ? Array.from(root.querySelectorAll<HTMLElement>('[data-studio-panel]'))
    : [];

  function escapeHtml(value: string) {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function wallPlaqueArrowSvg(dir: 'up' | 'down' | 'left' | 'right') {
    const rot = { up: 0, right: 90, down: 180, left: 270 }[dir];
    return `
      <span class="tour-wall-plaque__arrow" data-dir="${dir}" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" style="transform: rotate(${rot}deg)">
          <path
            d="M8 12.5V3.5M8 3.5 4.5 7M8 3.5 11.5 7"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
    `;
  }

  function wallPlaqueHtml(label: string, arrow: 'up' | 'down' | 'left' | 'right' = 'right') {
    return `
      <button type="button" class="tour-wall-plaque">
        <span class="tour-wall-plaque__label">${escapeHtml(label)}</span>
        ${wallPlaqueArrowSvg(arrow)}
      </button>
    `;
  }

  function setMainTab(tabId: string) {
    for (const tab of mainTabs) {
      const active = tab.dataset.studioMainTab === tabId;
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
      tab.setAttribute('data-active', active ? 'true' : 'false');
      tab.tabIndex = active ? 0 : -1;
    }

    for (const panel of panels) {
      const active = panel.dataset.studioPanel === tabId;
      panel.classList.toggle('hidden', !active);
      panel.hidden = !active;
    }

    if (tabId === 'locations') {
      window.dispatchEvent(new CustomEvent('znimay:locations-open'));
    }
  }

  const tourOpenBtn = root?.querySelector<HTMLButtonElement>('[data-tour-open]');
  const tourCloseBtns = tourModal
    ? Array.from(tourModal.querySelectorAll<HTMLElement>('[data-tour-close]'))
    : [];
  const swipeHint = tourModal?.querySelector<HTMLElement>('[data-tour-swipe-hint]');
  let swipeHintTimer = 0;

  function showSwipeHint() {
    if (!swipeHint) return;
    window.clearTimeout(swipeHintTimer);
    swipeHint.classList.add('is-visible');
    swipeHintTimer = window.setTimeout(() => {
      swipeHint.classList.remove('is-visible');
    }, 1000);
  }

  function openTourModal() {
    if (!tourModal) return;
    tourModal.hidden = false;
    tourModal.classList.remove('hidden');
    document.body.classList.add('tour-open');
    document.querySelector('header')?.setAttribute('aria-hidden', 'true');
    tourGyroStart?.();
    showSwipeHint();
    requestAnimationFrame(() => {
      window.dispatchEvent(new Event('resize'));
      window.dispatchEvent(new CustomEvent('znimay:tour-open'));
      tourModal.querySelector<HTMLElement>('[data-tour-close]')?.focus();
    });
  }

  function closeTourModal() {
    if (!tourModal) return;
    window.clearTimeout(swipeHintTimer);
    swipeHint?.classList.remove('is-visible');
    tourModal.hidden = true;
    tourModal.classList.add('hidden');
    document.body.classList.remove('tour-open');
    document.querySelector('header')?.removeAttribute('aria-hidden');
    tourGyroStop?.();
    tourOpenBtn?.focus();
  }

  tourOpenBtn?.addEventListener('click', () => openTourModal());
  window.addEventListener('znimay:tour-open-request', () => openTourModal());
  tourCloseBtns.forEach((btn) => {
    btn.addEventListener('click', () => closeTourModal());
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && document.body.classList.contains('tour-open')) {
      closeTourModal();
    }
  });

  function wireTablist(
    tabs: HTMLButtonElement[],
    onActivate: (tab: HTMLButtonElement) => void,
  ) {
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => onActivate(tab));
    });

    const parent = tabs[0]?.closest('[role="tablist"]');
    parent?.addEventListener('keydown', (event) => {
      if (!(event instanceof KeyboardEvent)) return;
      if (!(event.target instanceof HTMLElement)) return;
      if (!tabs.includes(event.target as HTMLButtonElement)) return;

      const current = tabs.indexOf(event.target as HTMLButtonElement);
      if (current < 0) return;

      let next = current;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (current + 1) % tabs.length;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp')
        next = (current - 1 + tabs.length) % tabs.length;
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = tabs.length - 1;

      if (next !== current) {
        event.preventDefault();
        tabs[next].focus();
        tabs[next].click();
      }
    });
  }

  if (root) {
    wireTablist(mainTabs, (tab) => {
      const id = tab.dataset.studioMainTab;
      if (id) setMainTab(id);
    });

    const carousel = root.querySelector<HTMLElement>('[data-locations-carousel]');
    const track = root.querySelector<HTMLElement>('[data-locations-track]');
    const slides = track
      ? Array.from(track.querySelectorAll<HTMLElement>('[data-locations-slide]'))
      : [];
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-locations-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-locations-next]');
    const count = Number(carousel?.dataset.locationsCount || 0) || 0;
    const loop = carousel?.dataset.locationsLoop === 'true' && count > 1;
    let activeLogical = 0;
    let activeDomIndex = loop ? count : 0;
    let jumping = false;
    let ready = false;
    let scrollRaf = 0;
    let settleTick = 0;

    function syncTrackPad() {
      if (!track || slides.length === 0) return;
      const slideW = slides[0].offsetWidth;
      if (track.clientWidth < 8 || slideW < 8) return;
      const pad = Math.max(0, (track.clientWidth - slideW) / 2);
      track.style.setProperty('--loc-pad', `${pad}px`);
    }

    function centerLeft(slide: HTMLElement) {
      if (!track) return 0;
      const slideRect = slide.getBoundingClientRect();
      const trackRect = track.getBoundingClientRect();
      const slideMid =
        slideRect.left - trackRect.left + track.scrollLeft + slideRect.width / 2;
      return slideMid - track.clientWidth / 2;
    }

    function findDomIndex(logical: number, preferredCopy = 1) {
      const preferred = slides.findIndex(
        (slide) =>
          Number(slide.dataset.logical) === logical &&
          Number(slide.dataset.copy ?? 0) === preferredCopy,
      );
      if (preferred >= 0) return preferred;
      return slides.findIndex((slide) => Number(slide.dataset.logical) === logical);
    }

    function setActiveVisual(logical: number, domIndex: number) {
      const nextLogical = ((logical % count) + count) % count;
      if (domIndex === activeDomIndex && nextLogical === activeLogical) return;
      activeLogical = nextLogical;
      activeDomIndex = domIndex;
      slides.forEach((slide, i) => {
        const on = i === domIndex;
        slide.dataset.active = String(on);
        slide.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
    }

    function scrollToSlide(slide: HTMLElement, behavior: ScrollBehavior) {
      if (!track) return;
      track.scrollTo({ left: Math.max(0, centerLeft(slide)), behavior });
    }

    function goToDom(domIndex: number, behavior: ScrollBehavior = 'smooth') {
      if (domIndex < 0 || domIndex >= slides.length) return;
      const slide = slides[domIndex];
      if (!track || !slide) return;
      const logical = Number(slide.dataset.logical);
      setActiveVisual(Number.isNaN(logical) ? 0 : logical, domIndex);
      scrollToSlide(slide, behavior);
    }

    function goToLogical(logical: number, behavior: ScrollBehavior = 'smooth') {
      if (count < 1) return;
      const target = ((logical % count) + count) % count;
      const preferredCopy = loop ? 1 : 0;
      const domIndex = findDomIndex(target, preferredCopy);
      if (domIndex < 0) return;
      goToDom(domIndex, behavior);
    }

    function goPrev() {
      if (count < 1) return;
      if (!ready) ensureReady(true);
      if (!ready) return;
      if (loop) {
        // Step one DOM slide left — wraps via cloned copies
        const next = activeDomIndex <= 0 ? slides.length - 1 : activeDomIndex - 1;
        goToDom(next, 'smooth');
      } else {
        goToLogical(activeLogical <= 0 ? count - 1 : activeLogical - 1, 'smooth');
      }
    }

    function goNext() {
      if (count < 1) return;
      if (!ready) ensureReady(true);
      if (!ready) return;
      if (loop) {
        const next = activeDomIndex >= slides.length - 1 ? 0 : activeDomIndex + 1;
        goToDom(next, 'smooth');
      } else {
        goToLogical(activeLogical >= count - 1 ? 0 : activeLogical + 1, 'smooth');
      }
    }

    function normalizeLoop() {
      if (!loop || !track || jumping) return;
      const slide = slides[activeDomIndex];
      if (!slide) return;
      const copy = Number(slide.dataset.copy ?? 1);
      if (copy === 1) return;
      const logical = Number(slide.dataset.logical);
      const middle = findDomIndex(Number.isNaN(logical) ? 0 : logical, 1);
      const middleSlide = slides[middle];
      if (middle < 0 || !middleSlide) return;

      jumping = true;
      const prevBehavior = track.style.scrollBehavior;
      track.style.scrollBehavior = 'auto';
      scrollToSlide(middleSlide, 'auto');
      track.style.scrollBehavior = prevBehavior;
      setActiveVisual(Number.isNaN(logical) ? 0 : logical, middle);
      requestAnimationFrame(() => {
        jumping = false;
      });
    }

    function syncActiveFromScroll() {
      if (!track || jumping || !ready) return;
      const center = track.scrollLeft + track.clientWidth / 2;
      let nearest = activeDomIndex;
      let best = Infinity;
      slides.forEach((slide, i) => {
        const mid = slide.offsetLeft + slide.clientWidth / 2;
        const dist = Math.abs(mid - center);
        if (dist < best) {
          best = dist;
          nearest = i;
        }
      });
      const slide = slides[nearest];
      const logical = Number(slide?.dataset.logical ?? 0);
      setActiveVisual(Number.isNaN(logical) ? 0 : logical, nearest);
    }

    function settleFromScroll() {
      if (!track || jumping || !ready) return;
      syncActiveFromScroll();
      normalizeLoop();
    }

    function ensureReady(force = false) {
      if (!track || slides.length === 0 || count < 1) return;
      if (ready && !force) return;
      // Panel must be visible for correct offset measurements
      const panel = root.querySelector<HTMLElement>('[data-studio-panel="locations"]');
      if (panel?.hidden || panel?.classList.contains('hidden')) return;

      syncTrackPad();

      const start = loop ? findDomIndex(0, 1) : 0;
      if (start < 0) return;
      const startSlide = slides[start];
      if (!startSlide || track.clientWidth < 8 || startSlide.clientWidth < 8) {
        requestAnimationFrame(() => ensureReady(force));
        return;
      }

      jumping = true;
      const prevBehavior = track.style.scrollBehavior;
      track.style.scrollBehavior = 'auto';
      goToDom(start, 'auto');
      track.style.scrollBehavior = prevBehavior;
      jumping = false;
      ready = true;
    }

    function recenterActive(behavior: ScrollBehavior = 'auto') {
      if (!track) return;
      const slide = slides[activeDomIndex];
      if (!slide) return;
      syncTrackPad();
      jumping = true;
      const prevBehavior = track.style.scrollBehavior;
      track.style.scrollBehavior = behavior === 'auto' ? 'auto' : prevBehavior;
      scrollToSlide(slide, behavior);
      track.style.scrollBehavior = prevBehavior;
      requestAnimationFrame(() => {
        jumping = false;
      });
    }

    prevBtn?.addEventListener('click', (event) => {
      event.preventDefault();
      goPrev();
    });
    nextBtn?.addEventListener('click', (event) => {
      event.preventDefault();
      goNext();
    });

    if (track && slides.length > 0) {
      track.addEventListener(
        'scroll',
        () => {
          if (jumping) return;
          if (!scrollRaf) {
            scrollRaf = requestAnimationFrame(() => {
              scrollRaf = 0;
              syncActiveFromScroll();
            });
          }
          window.clearTimeout(settleTick);
          settleTick = window.setTimeout(settleFromScroll, 90);
        },
        { passive: true },
      );

      track.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          goNext();
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          goPrev();
        }
      });

      const bootCarousel = () => {
        syncTrackPad();
        ensureReady(true);
        recenterActive('auto');
      };

      window.addEventListener('znimay:locations-open', () => {
        carousel?.classList.add('is-visible');
        requestAnimationFrame(() => {
          requestAnimationFrame(bootCarousel);
        });
        window.setTimeout(bootCarousel, 80);
      });

      window.addEventListener('resize', () => {
        const panel = root.querySelector<HTMLElement>('[data-studio-panel="locations"]');
        if (panel?.hidden || panel?.classList.contains('hidden')) return;
        syncTrackPad();
        if (!ready) {
          ensureReady(true);
          return;
        }
        recenterActive('auto');
      });

      // Lightbox for location stills
      const lightbox = root.querySelector<HTMLDialogElement>('[data-locations-lightbox]');
      const lightboxImg = lightbox?.querySelector<HTMLImageElement>('[data-locations-lightbox-img]');
      const lightboxStage = lightbox?.querySelector<HTMLElement>('[data-locations-lightbox-stage]');
      const lightboxItems: { src: string; alt: string }[] = [];
      for (let i = 0; i < count; i++) {
        const preferred =
          slides.find(
            (el) =>
              Number(el.dataset.logical) === i && Number(el.dataset.copy ?? 0) === (loop ? 1 : 0),
          ) ?? slides.find((el) => Number(el.dataset.logical) === i);
        if (!preferred) continue;
        const src = preferred.getAttribute('data-lightbox-src') || '';
        if (!src) continue;
        lightboxItems.push({
          src,
          alt: preferred.getAttribute('data-lightbox-alt') || '',
        });
      }
      let lightboxIndex = 0;
      let pointerStartX = 0;
      let pointerMoved = false;

      function showLightbox(index: number) {
        if (!lightbox || !lightboxImg || lightboxItems.length === 0) return;
        lightboxIndex = ((index % lightboxItems.length) + lightboxItems.length) % lightboxItems.length;
        const item = lightboxItems[lightboxIndex];
        lightboxImg.src = item.src;
        lightboxImg.alt = item.alt;
        if (!lightbox.open) {
          lightbox.showModal();
          document.body.classList.add('lightbox-open');
        }
      }

      function closeLightbox() {
        if (!lightbox?.open) return;
        lightbox.close();
        document.body.classList.remove('lightbox-open');
      }

      root.querySelectorAll<HTMLButtonElement>('[data-locations-open]').forEach((btn) => {
        btn.addEventListener('pointerdown', (event) => {
          pointerStartX = event.clientX;
          pointerMoved = false;
        });
        btn.addEventListener('pointermove', (event) => {
          if (Math.abs(event.clientX - pointerStartX) > 10) pointerMoved = true;
        });
        btn.addEventListener('click', (event) => {
          if (pointerMoved) {
            event.preventDefault();
            return;
          }
          const logical = Number(btn.dataset.logical);
          if (Number.isNaN(logical)) return;
          showLightbox(logical);
        });
      });

      lightbox?.querySelector('[data-locations-lightbox-close]')?.addEventListener('click', (event) => {
        event.stopPropagation();
        closeLightbox();
      });
      lightbox?.querySelector('[data-locations-lightbox-prev]')?.addEventListener('click', (event) => {
        event.stopPropagation();
        showLightbox(lightboxIndex - 1);
      });
      lightbox?.querySelector('[data-locations-lightbox-next]')?.addEventListener('click', (event) => {
        event.stopPropagation();
        showLightbox(lightboxIndex + 1);
      });
      lightboxStage?.addEventListener('click', (event) => {
        if (event.target === lightboxStage || event.target === lightboxImg) closeLightbox();
      });
      lightbox?.addEventListener('cancel', () => {
        document.body.classList.remove('lightbox-open');
      });
      window.addEventListener('keydown', (event) => {
        if (!lightbox?.open) return;
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          showLightbox(lightboxIndex - 1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          showLightbox(lightboxIndex + 1);
        }
      });
    }
  }

  if (root && el) {
    const config = JSON.parse(root.dataset.tourConfig || '{}') as TourConfig;
    const nodeById = new Map(config.nodes.map((node) => [node.id, node]));
    const startView = nodeById.get(config.startNodeId)?.view ?? { yaw: '0deg', pitch: '0deg' };
    const minFov = 30;
    const maxFov = 120;
    const defaultFov = 80;
    /** PSV zoom 0 = maxFov (out), 100 = minFov (in) */
    const fovToZoomLvl = (fov: number) =>
      Math.round(((maxFov - fov) / (maxFov - minFov)) * 100);
    const defaultZoomLvl = fovToZoomLvl(defaultFov);

    const tourNodesForPlugin = config.nodes.map((node) => ({
      id: node.id,
      name: node.name,
      panorama: node.panorama,
      sphereCorrection: node.sphereCorrection,
      links: node.forwardLinks.map((link) => ({
        nodeId: link.nodeId,
        name: link.name,
        position: link.position,
      })),
      markers: node.wallLinks.map((link) => ({
        id: `wall-${node.id}-${link.nodeId}`,
        position: link.position,
        html: wallPlaqueHtml(link.name, link.arrow ?? 'right'),
        anchor: 'center center' as const,
        size: { width: 132, height: 40 },
        zIndex: 20,
        data: { goto: link.nodeId },
      })),
    }));

    // Assigned below; transitionOptions runs after Viewer exists.
    let viewer!: Viewer;

    viewer = new Viewer({
      container: el,
      loadingTxt: config.loadingTxt || '',
      navbar: ['zoomIn', 'zoomRange', 'zoomOut', 'moveUp', 'moveLeft', 'moveDown', 'moveRight', 'fullscreen'],
      defaultYaw: startView.yaw,
      defaultPitch: startView.pitch,
      defaultZoomLvl,
      minFov,
      maxFov,
      mousemove: true,
      mousewheel: true,
      plugins: [
        MarkersPlugin.withConfig({}),
        GyroscopePlugin.withConfig({
          touchmove: true,
          roll: true,
          absolutePosition: false,
          moveMode: 'fast',
        }),
        VirtualTourPlugin.withConfig({
          dataMode: 'client',
          positionMode: 'manual',
          renderMode: '3d',
          startNodeId: config.startNodeId,
          preload: true,
          nodes: tourNodesForPlugin,
          // Same room: keep look direction (Street View).
          // Other room: snap to that node's default `view`.
          transitionOptions: (toNode, fromNode) => {
            const to = nodeById.get(toNode.id);
            const from = fromNode ? nodeById.get(fromNode.id) : undefined;
            const sameRoom = Boolean(from && to && from.room === to.room);
            const gyroPlugin = viewer.getPlugin(GyroscopePlugin) as GyroscopePlugin | undefined;
            if (!sameRoom && gyroPlugin?.isEnabled()) gyroPlugin.stop();

            if (sameRoom) {
              const { yaw, pitch } = viewer.getPosition();
              return {
                showLoader: false,
                speed: '20rpm',
                effect: 'fade' as const,
                rotation: false,
                rotateTo: { yaw, pitch },
                zoomTo: viewer.getZoomLevel(),
              };
            }

            const view = to?.view ?? { yaw: '0deg', pitch: '0deg' };
            return {
              showLoader: false,
              speed: '20rpm',
              effect: 'fade' as const,
              rotation: true,
              rotateTo: view,
              zoomTo: defaultZoomLvl,
            };
          },
          arrowStyle: {
            className: 'znimay-tour-arrow',
            style: {
              color: '#dfb4c4',
            },
          },
        }),
      ],
    });

    const tour = viewer.getPlugin(VirtualTourPlugin) as VirtualTourPlugin;
    const markers = viewer.getPlugin(MarkersPlugin) as MarkersPlugin;
    const gyro = viewer.getPlugin(GyroscopePlugin) as GyroscopePlugin;
    const gyroHint = tourModal?.querySelector<HTMLElement>('[data-pano-gyro-hint]');
    const gyroToggle = tourModal?.querySelector<HTMLButtonElement>('[data-tour-gyro]');
    const panoRoot = el.closest<HTMLElement>('.studio-pano');
    const GYRO_PREF_KEY = 'znimay-tour-gyro';

    const isGyroDevice = () =>
      window.matchMedia('(max-width: 767px)').matches ||
      document.documentElement.getAttribute('data-mobile-app-active') === 'true';

    const readGyroPref = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
      try {
        const stored = localStorage.getItem(GYRO_PREF_KEY);
        if (stored === '0') return false;
        if (stored === '1') return true;
      } catch {
        /* ignore */
      }
      return true;
    };

    let gyroWanted = readGyroPref();

    const syncGyroUi = () => {
      const wanted = isGyroDevice() && gyroWanted;
      const active = wanted && gyro.isEnabled();
      panoRoot?.setAttribute('data-gyro', active ? 'on' : 'off');
      gyroToggle?.setAttribute('aria-pressed', String(wanted));
      const label = wanted
        ? gyroToggle?.getAttribute('data-gyro-on')
        : gyroToggle?.getAttribute('data-gyro-off');
      if (label) gyroToggle?.setAttribute('aria-label', label);
      if (!wanted) gyroHint?.setAttribute('data-hidden', 'true');
    };

    tourGyroStart = () => {
      if (!isGyroDevice() || !gyroWanted) {
        syncGyroUi();
        return;
      }
      void gyro
        .start('fast')
        .then(() => {
          gyroHint?.removeAttribute('data-hidden');
          syncGyroUi();
          window.setTimeout(() => gyroHint?.setAttribute('data-hidden', 'true'), 3500);
        })
        .catch(() => {
          gyroWanted = false;
          gyroHint?.setAttribute('data-hidden', 'true');
          syncGyroUi();
        });
    };

    tourGyroStop = () => {
      gyro.stop();
      gyroHint?.removeAttribute('data-hidden');
      syncGyroUi();
    };

    const ensureTourGyro = () => {
      if (!isGyroDevice() || !gyroWanted || !document.body.classList.contains('tour-open')) return;
      if (gyro.isEnabled()) return;
      void gyro.start('fast').then(syncGyroUi).catch(() => {});
    };

    gyroToggle?.addEventListener('click', () => {
      gyroWanted = !gyroWanted;
      try {
        localStorage.setItem(GYRO_PREF_KEY, gyroWanted ? '1' : '0');
      } catch {
        /* ignore */
      }
      syncGyroUi();
      if (gyroWanted) tourGyroStart?.();
      else gyro.stop();
    });

    syncGyroUi();

    const TOUR_CTRL_ORDER = [
      'zoomIn',
      'zoomRange',
      'zoomOut',
      'moveUp',
      'moveLeft',
      'moveDown',
      'moveRight',
      'fullscreen',
    ] as const;

    const layoutTourControls = () => {
      const nav = el.querySelector<HTMLElement>('.psv-navbar');
      if (!nav) return;
      if (isGyroDevice()) {
        nav.hidden = true;
        nav.style.display = 'none';
        return;
      }
      nav.hidden = false;
      nav.style.display = '';
      nav.classList.add('tour-psv-navbar');

      const known = new Set<string>(TOUR_CTRL_ORDER);
      const byId = new Map<string, HTMLElement>();

      for (const btn of Array.from(nav.querySelectorAll<HTMLElement>('.psv-button'))) {
        const tagged = btn.dataset.tourCtrl;
        if (tagged && known.has(tagged)) byId.set(tagged, btn);
      }

      if (byId.size < TOUR_CTRL_ORDER.length) {
        const untagged = Array.from(nav.querySelectorAll<HTMLElement>(':scope > .psv-button'));
        untagged.forEach((btn, index) => {
          const id = TOUR_CTRL_ORDER[index];
          if (!id || byId.has(id)) return;
          btn.dataset.tourCtrl = id;
          byId.set(id, btn);
        });
      }

      let zoomWrap = nav.querySelector<HTMLElement>('.tour-zoom');
      if (!zoomWrap) {
        zoomWrap = document.createElement('div');
        zoomWrap.className = 'tour-zoom';
        nav.appendChild(zoomWrap);
      }
      for (const id of ['zoomIn', 'zoomRange', 'zoomOut'] as const) {
        const btn = byId.get(id);
        if (btn) zoomWrap.appendChild(btn);
      }

      let dpad = nav.querySelector<HTMLElement>('.tour-dpad');
      if (!dpad) {
        dpad = document.createElement('div');
        dpad.className = 'tour-dpad';
        nav.appendChild(dpad);
      }
      for (const id of ['moveUp', 'moveLeft', 'moveDown', 'moveRight'] as const) {
        const btn = byId.get(id);
        if (btn) dpad.appendChild(btn);
      }

      let fsWrap = nav.querySelector<HTMLElement>('.tour-fs');
      if (!fsWrap) {
        fsWrap = document.createElement('div');
        fsWrap.className = 'tour-fs';
        nav.appendChild(fsWrap);
      }
      const fsBtn = byId.get('fullscreen');
      if (fsBtn) fsWrap.appendChild(fsBtn);
    };

    layoutTourControls();

    // Warm LQ for hops; HQ upgrades after each node enter.
    viewer.addEventListener(
      'ready',
      () => {
        layoutTourControls();
        for (const node of config.nodes) {
          void viewer.textureLoader.preloadPanorama(node.panorama).catch(() => {});
        }
        void upgradeToHq(config.startNodeId);
      },
      { once: true },
    );

    window.addEventListener('znimay:tour-open', () => {
      window.dispatchEvent(new Event('resize'));
      const current = tour.getCurrentNode();
      if (current) syncMarkers(current.id);
      ensureTourGyro();
    });

    let currentNodeId = config.startNodeId;
    let hqUpgradeToken = 0;

    const warmNeighborHq = (nodeId: string) => {
      const node = nodeById.get(nodeId);
      if (!node) return;
      for (const link of [...node.forwardLinks, ...node.wallLinks]) {
        const next = nodeById.get(link.nodeId);
        if (next?.panoramaHq) {
          void viewer.textureLoader.preloadPanorama(next.panoramaHq).catch(() => {});
        }
      }
    };

    /** Swap LQ → HQ without loader / blink once the larger texture is ready. */
    const upgradeToHq = async (nodeId: string) => {
      const payload = nodeById.get(nodeId);
      if (!payload?.panoramaHq) return;

      const token = ++hqUpgradeToken;
      try {
        await viewer.textureLoader.preloadPanorama(payload.panoramaHq);
        if (token !== hqUpgradeToken || currentNodeId !== nodeId) return;

        const { yaw, pitch } = viewer.getPosition();
        const zoom = viewer.getZoomLevel();
        const completed = await viewer.setPanorama(payload.panoramaHq, {
          showLoader: false,
          transition: false,
          sphereCorrection: payload.sphereCorrection,
          position: { yaw, pitch },
          zoom,
        });
        if (!completed || token !== hqUpgradeToken || currentNodeId !== nodeId) return;
        requestAnimationFrame(() => syncMarkers(nodeId));
        warmNeighborHq(nodeId);
        ensureTourGyro();
      } catch {
        // Keep LQ if HQ fails
      }
    };

    const setActiveRoomTab = (roomId: string) => {
      for (const tab of roomTabs) {
        const active = tab.dataset.roomId === roomId;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.setAttribute('data-active', active ? 'true' : 'false');
        tab.tabIndex = active ? 0 : -1;
        if (active) {
          el.setAttribute('aria-labelledby', tab.id);
          const strip = tab.parentElement;
          if (strip) {
            const left = tab.offsetLeft - (strip.clientWidth - tab.clientWidth) / 2;
            strip.scrollTo({ left: Math.max(0, left), behavior: 'smooth' });
          }
        }
      }
    };

    const syncMarkers = (nodeId: string) => {
      currentNodeId = nodeId;
      const node = nodeById.get(nodeId);
      const wall = (node?.wallLinks || []).map((link) => ({
        id: `wall-${nodeId}-${link.nodeId}`,
        position: link.position,
        html: wallPlaqueHtml(link.name, link.arrow ?? 'right'),
        anchor: 'center center',
        size: { width: 132, height: 40 },
        zIndex: 20,
        data: { goto: link.nodeId },
      }));

      markers.setMarkers(wall);
    };

    const goToNode = (nodeId: string) => {
      const current = tour.getCurrentNode();
      if (current?.id === nodeId) {
        const payload = nodeById.get(nodeId);
        if (payload) setActiveRoomTab(payload.room);
        return;
      }
      void tour.setCurrentNode(nodeId);
    };

    const setPanoName = (name: string | undefined) => {
      if (!nameEl || !name) return;
      nameEl.textContent = name;
    };

    tour.addEventListener('node-changed', ({ node }) => {
      currentNodeId = node.id;
      const payload = nodeById.get(node.id);
      if (payload) setActiveRoomTab(payload.room);
      setPanoName(payload?.name ?? node.name);
      // After VirtualTourPlugin finishes installing node.markers
      requestAnimationFrame(() => syncMarkers(node.id));
      void upgradeToHq(node.id);
      ensureTourGyro();
    });

    markers.addEventListener('select-marker', ({ marker }) => {
      const goto = marker.data?.goto as string | undefined;
      if (!goto) return;
      const current = nodeById.get(currentNodeId);
      const wall = current?.wallLinks.find((link) => link.nodeId === goto);
      void tour.setCurrentNode(
        goto,
        undefined,
        wall ? { nodeId: goto, position: wall.position } : undefined,
      );
    });

    viewer.addEventListener(
      'ready',
      () => {
        const current = tour.getCurrentNode();
        if (current) syncMarkers(current.id);
      },
      { once: true },
    );

    // If start node already loaded before listeners attached
    {
      const current = tour.getCurrentNode();
      if (current) syncMarkers(current.id);
    }

    wireTablist(roomTabs, (tab) => {
      const nodeId = tab.dataset.startNode;
      if (!nodeId) return;
      goToNode(nodeId);
    });
  }
</script>
