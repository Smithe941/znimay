---
import { t } from '../i18n/ui';
import { tourNodes, tourRooms, panoramaHqPath } from '../data/spaces';
import { fetchLocationImages, imageUrl } from '../lib/cloudinary';

const uk = t('uk');
const base = import.meta.env.BASE_URL;

const rooms = tourRooms.map((room) => ({
  ...room,
  previewUrl: `${base}media/${room.preview}`,
}));

const cloudLocations = await fetchLocationImages();
const locationSlides =
  cloudLocations.length > 0
    ? cloudLocations
        .filter((image) => image.resourceType === 'image')
        .map((image, index) => ({
          id: image.publicId,
          src: imageUrl(image.publicId, 'location'),
          lightboxSrc: imageUrl(image.publicId, 'lightbox'),
          alt: image.alt,
          label: null as string | null,
          blurb: null as string | null,
          index,
        }))
    : rooms.map((room, index) => ({
        id: room.id,
        src: room.previewUrl,
        lightboxSrc: room.previewUrl,
        alt: room.label,
        label: room.label,
        blurb: room.blurb,
        index,
      }));

const locationLoop =
  locationSlides.length > 1
    ? [0, 1, 2].flatMap((copy) =>
        locationSlides.map((slide) => ({
          ...slide,
          copy,
          key: `${copy}-${slide.id}`,
        })),
      )
    : locationSlides.map((slide) => ({
        ...slide,
        copy: 0,
        key: `0-${slide.id}`,
      }));
const locationLoopEnabled = locationSlides.length > 1;
const nodesPayload = tourNodes.map((node) => ({
  id: node.id,
  room: node.room,
  panorama: `${base}media/${node.panorama}`,
  panoramaHq: `${base}media/${panoramaHqPath(node.panorama)}`,
  name: node.name,
  view: node.view,
  sphereCorrection: node.sphereCorrection,
  forwardLinks: node.links
    .filter((link) => link.kind === 'forward')
    .map((link) => ({
      nodeId: link.nodeId,
      name: link.name,
      position: link.position,
    })),
  wallLinks: node.links
    .filter((link) => link.kind === 'wall')
    .map((link) => ({
      nodeId: link.nodeId,
      name: link.name,
      position: link.position,
      arrow: link.arrow ?? 'right',
    })),
}));

const tourConfig = {
  startNodeId: 'room_1_4' as const,
  loadingTxt: uk.studio.panoLoading,
  nodes: nodesPayload,
};

const startNode =
  nodesPayload.find((node) => node.id === tourConfig.startNodeId) ?? nodesPayload[0];

const mainTabs = [
  { id: 'info', label: uk.studio.tabInfo },
  { id: 'locations', label: uk.studio.tabLocations },
] as const;

const advantages = uk.studio.advantages;
---

<section
  id="studio"
  data-tab="studio"
  class="chapter chapter--surface chapter-pad snap-section flex flex-col md:h-[100dvh] md:max-h-[100dvh] md:overflow-hidden"
  data-studio-spaces
  data-tour-config={JSON.stringify(tourConfig)}
>
  <div class="mx-auto flex min-h-0 w-full max-w-6xl flex-1 flex-col">
    <div class="shrink-0">
      <div class="flex items-center justify-between gap-4">
        <h2 class="chapter-title min-w-0">
          {uk.studio.title}
        </h2>
        <button
          type="button"
          class="studio-tour-cta cursor-pointer shrink-0 px-3.5 py-2 text-left transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/50 focus-visible:ring-offset-2 focus-visible:ring-offset-surface sm:px-4 sm:py-2.5"
          data-tour-open
          aria-haspopup="dialog"
          aria-controls="studio-tour-modal"
        >
          <span class="block text-[0.65rem] tracking-[0.16em] uppercase sm:text-xs">
            {uk.studio.tabTour}
          </span>
          <span class="mt-1 block text-[0.65rem] leading-none tracking-wide text-ink/70 normal-case">
            {uk.studio.tabTourHint}
          </span>
        </button>
      </div>

      <p class="chapter-lede max-w-xl text-muted">
        {uk.studio.subtitle}
      </p>

      <div
        class="studio-main-nav mt-4 flex gap-6 border-b border-ink/10 sm:mt-6 sm:gap-8"
        role="tablist"
        aria-label={uk.studio.title}
        data-studio-main-tabs
      >
        {
          mainTabs.map((tab, index) => (
            <button
              type="button"
              role="tab"
              id={`studio-main-${tab.id}`}
              class="studio-main-tab cursor-pointer border-b-2 border-transparent pb-3 text-[0.65rem] tracking-[0.16em] uppercase text-muted transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/30 focus-visible:ring-offset-2 focus-visible:ring-offset-surface sm:text-xs"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`studio-panel-${tab.id}`}
              data-studio-main-tab={tab.id}
              data-active={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
            >
              {tab.label}
            </button>
          ))
        }
      </div>
    </div>

    <div
      class="min-h-0 pt-4 sm:pt-6 md:flex-1 md:overflow-y-auto md:overscroll-y-auto"
      data-studio-scroll
    >
      <!-- Panel: Info -->
      <div
        id="studio-panel-info"
        role="tabpanel"
        aria-labelledby="studio-main-info"
        data-studio-panel="info"
        class="pb-4"
      >
        <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2 md:gap-x-10">
          {
            advantages.map((item) => (
              <li class="flex gap-3 text-[0.875rem] leading-snug text-ink/80 sm:text-[0.95rem]">
                <span
                  class="mt-[0.45em] h-1 w-1 shrink-0 rounded-full bg-blush"
                  aria-hidden="true"
                />
                <span>
                  {item}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Panel: Locations -->
      <div
        id="studio-panel-locations"
        role="tabpanel"
        aria-labelledby="studio-main-locations"
        data-studio-panel="locations"
        class="hidden"
        hidden
      >
        <div
          data-locations-carousel
          data-locations-count={locationSlides.length}
          data-locations-loop={locationLoopEnabled ? 'true' : 'false'}
        >
          <div
            class="locations-track scrollbar-none -mx-4 flex touch-pan-x snap-x snap-mandatory items-center gap-3 overflow-x-auto overscroll-x-contain scroll-smooth py-4 sm:-mx-6 sm:py-6 md:mx-0 md:py-8"
            data-locations-track
            tabindex="0"
            aria-roledescription="carousel"
            aria-label={uk.studio.tabLocations}
          >
          {
            locationLoop.map((slide) => (
              <article
                class="locations-slide relative w-[12.5rem] shrink-0 overflow-hidden bg-ink text-blush-soft sm:w-[15rem] md:w-[17rem]"
                data-locations-slide
                data-logical={slide.index}
                data-copy={slide.copy}
                data-lightbox-src={slide.lightboxSrc}
                data-lightbox-alt={slide.alt}
                data-active={
                  slide.copy === (locationLoopEnabled ? 1 : 0) && slide.index === 0 ? 'true' : 'false'
                }
                aria-roledescription="slide"
                aria-label={`${slide.index + 1} / ${locationSlides.length}`}
                aria-hidden={
                  slide.copy === (locationLoopEnabled ? 1 : 0) && slide.index === 0 ? 'false' : 'true'
                }
              >
                <button
                  type="button"
                  class="locations-slide__open relative block aspect-[3/4] w-full cursor-pointer text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
                  data-locations-open
                  data-logical={slide.index}
                  aria-label={slide.alt}
                >
                  <img
                    src={slide.src}
                    alt=""
                    class="absolute inset-0 h-full w-full object-cover"
                    loading={
                      slide.copy === (locationLoopEnabled ? 1 : 0) && slide.index === 0
                        ? 'eager'
                        : 'lazy'
                    }
                    draggable="false"
                  />
                  {
                    (slide.label || slide.blurb) && (
                      <div class="pointer-events-none absolute inset-x-0 bottom-0 p-2.5 sm:p-3">
                        {slide.label && (
                          <h3 class="font-display text-base leading-none tracking-wide text-blush drop-shadow-[0_1px_2px_rgb(0_0_0_/_55%)] sm:text-lg">
                            {slide.label}
                          </h3>
                        )}
                        {slide.blurb && (
                          <p class="mt-1 text-[0.65rem] leading-snug text-blush-soft/90 drop-shadow-[0_1px_2px_rgb(0_0_0_/_55%)]">
                            {slide.blurb}
                          </p>
                        )}
                      </div>
                    )
                  }
                </button>
              </article>
            ))
          }
        </div>

        <div class="mt-4 hidden items-center justify-end gap-2 md:flex">
          <button
            type="button"
            class="flex size-11 cursor-pointer items-center justify-center border border-ink/20 text-ink transition hover:border-ink hover:bg-ink hover:text-blush focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-surface active:opacity-80"
            data-locations-prev
            aria-label={uk.studio.locationsPrev}
          >
            <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M10 3 5 8l5 5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <button
            type="button"
            class="flex size-11 cursor-pointer items-center justify-center border border-ink/20 text-ink transition hover:border-ink hover:bg-ink hover:text-blush focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-surface active:opacity-80"
            data-locations-next
            aria-label={uk.studio.locationsNext}
          >
            <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M6 3l5 5-5 5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>
      </div>
      </div>
    </div>
  </div>

  <dialog
    class="locations-lightbox m-0 h-full max-h-none w-full max-w-none border-0 bg-ink/95 p-0 text-surface backdrop:bg-transparent"
    data-locations-lightbox
  >
    <div
      class="relative flex h-full w-full cursor-pointer items-center justify-center p-3 sm:p-6"
      data-locations-lightbox-stage
    >
      <button
        type="button"
        class="absolute top-3 right-3 z-20 flex size-11 cursor-pointer items-center justify-center border border-blush/35 text-blush transition hover:border-blush hover:bg-blush/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/50 sm:top-5 sm:right-5"
        data-locations-lightbox-close
        aria-label={uk.portfolio.lightboxClose}
      >
        <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M3.5 3.5 12.5 12.5M12.5 3.5 3.5 12.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
      </button>
      <button
        type="button"
        class="absolute top-1/2 left-2 z-20 flex size-11 -translate-y-1/2 cursor-pointer items-center justify-center border border-blush/35 text-blush transition hover:border-blush hover:bg-blush/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/50 sm:left-4"
        data-locations-lightbox-prev
        aria-label={uk.portfolio.lightboxPrev}
      >
        <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M10 3 5 8l5 5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
      <button
        type="button"
        class="absolute top-1/2 right-2 z-20 flex size-11 -translate-y-1/2 cursor-pointer items-center justify-center border border-blush/35 text-blush transition hover:border-blush hover:bg-blush/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/50 sm:right-4"
        data-locations-lightbox-next
        aria-label={uk.portfolio.lightboxNext}
      >
        <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M6 3l5 5-5 5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
      <img
        src=""
        alt=""
        class="max-h-[85dvh] max-w-[min(100%,calc(100%-5.5rem))] object-contain sm:max-w-[min(100%,calc(100%-8rem))]"
        data-locations-lightbox-img
        draggable="false"
      />
    </div>
  </dialog>

  <!-- 3D Tour modal -->
  <div
    id="studio-tour-modal"
    class="studio-tour-modal fixed inset-0 z-[100] hidden"
    data-tour-modal
    hidden
    role="dialog"
    aria-modal="true"
    aria-label={uk.studio.tabTour}
  >
    <div class="absolute inset-0 bg-ink/80 backdrop-blur-sm" data-tour-close aria-hidden="true"></div>
    <div
      class="relative z-10 flex h-full max-h-[100dvh] flex-col bg-surface text-ink shadow-2xl sm:mx-auto sm:my-[max(1rem,4vh)] sm:h-[min(92dvh,880px)] sm:max-w-6xl sm:overflow-hidden sm:rounded-sm sm:border sm:border-ink/10"
    >
      <div class="studio-room-nav flex shrink-0 items-center gap-1 border-b border-ink/10 pl-2 pr-1 sm:pl-4 sm:pr-2">
        <div
          class="scrollbar-none min-w-0 flex-1 overflow-x-auto"
          role="tablist"
          aria-label={uk.studio.roomsNav}
          data-room-tabs
        >
          <div class="flex gap-1 py-2 sm:gap-2">
            {
              rooms.map((room, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`space-tab-${room.id}`}
                  class="studio-tab-link cursor-pointer shrink-0 px-3 py-2 text-xs tracking-[0.16em] uppercase text-muted transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-controls="studio-pano"
                  data-space-tab
                  data-room-id={room.id}
                  data-start-node={room.startNodeId}
                  data-active={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                >
                  {room.label}
                </button>
              ))
            }
          </div>
        </div>
        <button
          type="button"
          class="flex size-11 shrink-0 cursor-pointer items-center justify-center border border-ink/20 text-ink transition hover:border-ink hover:bg-ink hover:text-blush focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
          data-tour-close
          aria-label={uk.studio.tourClose}
        >
          <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3.5 3.5 12.5 12.5M12.5 3.5 3.5 12.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>

      <figure class="studio-pano relative min-h-0 flex-1 overflow-hidden bg-ink" data-gyro="off">
        <div
          id="studio-pano"
          class="h-full min-h-[50svh] w-full"
          role="tabpanel"
          aria-labelledby="space-tab-room_1"
        >
        </div>
        <figcaption
          class="pointer-events-none absolute top-4 left-1/2 z-20 m-0 w-[min(92%,24rem)] -translate-x-1/2 sm:top-5"
        >
          <p
            class="tour-pano-name mx-auto w-fit text-center text-sm font-medium tracking-[0.16em] uppercase text-blush sm:text-base"
            data-pano-name
          >
            {startNode.name}
          </p>
          <p
            class="mx-auto mt-2 w-fit max-w-[20rem] px-2 text-center text-[0.65rem] tracking-[0.14em] uppercase text-blush-soft/90 md:hidden"
            data-pano-gyro-hint
          >
            {uk.studio.panoGyroHint}
          </p>
        </figcaption>
        <div class="tour-swipe-hint" data-tour-swipe-hint aria-hidden="true">
          <svg class="tour-swipe-hint__icon" viewBox="0 0 96 40" fill="none" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" d="M22 20h52" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M30 12 20 20l10 8" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M66 12l10 8-10 8" />
          </svg>
        </div>
        <button
          type="button"
          class="tour-gyro-toggle"
          data-tour-gyro
          data-gyro-on={uk.studio.gyroOn}
          data-gyro-off={uk.studio.gyroOff}
          aria-pressed="false"
          aria-label={uk.studio.gyroOff}
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="12" cy="12" r="8.25" />
            <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none" />
            <path stroke-linecap="round" d="M12 3.75V6.5M12 17.5v2.75M3.75 12H6.5M17.5 12h2.75" />
          </svg>
        </button>
      </figure>
    </div>
  </div>
</section>

<style>
  .studio-main-tab[data-active='true'] {
    border-bottom-color: var(--color-ink);
    color: var(--color-ink);
  }

  .tour-pano-name {
    margin: 0 auto;
    padding: 0.4rem 1.6rem;
    background: radial-gradient(
      ellipse 50% 60% at 50% 50%,
      rgb(26 18 20 / 28%) 0%,
      rgb(26 18 20 / 10%) 38%,
      rgb(26 18 20 / 0%) 70%
    );
    text-shadow:
      0 1px 2px rgb(0 0 0 / 70%),
      0 0 16px rgb(0 0 0 / 55%),
      0 0 28px rgb(26 18 20 / 40%);
  }

  @media (min-width: 640px) {
    .tour-pano-name {
      padding: 0.5rem 1.9rem;
    }
  }

  .tour-gyro-toggle {
    display: none;
    position: absolute;
    left: max(0.9rem, calc(env(safe-area-inset-left, 0px) + 0.75rem));
    bottom: max(0.9rem, calc(env(safe-area-inset-bottom, 0px) + 0.75rem));
    z-index: 22;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid color-mix(in srgb, #dfb4c4 28%, transparent);
    border-radius: 999px;
    background: rgb(37 34 35 / 62%);
    color: color-mix(in srgb, #dfb4c4 62%, #6a5a60);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      transform 0.12s ease;
  }

  .tour-gyro-toggle::after {
    content: '';
    position: absolute;
    width: 22px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transform: rotate(-42deg);
    opacity: 1;
    transition: opacity 0.16s ease, transform 0.16s ease;
  }

  .tour-gyro-toggle:active {
    transform: scale(0.92);
  }

  @media (max-width: 767px) {
    .tour-gyro-toggle {
      display: inline-flex;
    }
  }

  :global(html[data-mobile-app-active='true']) .tour-gyro-toggle {
    display: inline-flex;
  }

  .tour-gyro-toggle[aria-pressed='true'] {
    border-color: #dfb4c4;
    background: #dfb4c4;
    color: #252223;
    box-shadow:
      0 0 0 3px rgb(223 180 196 / 30%),
      0 0 18px rgb(223 180 196 / 40%);
  }

  .tour-gyro-toggle[aria-pressed='true']::after {
    opacity: 0;
    transform: rotate(-42deg) scaleX(0.2);
  }

  .studio-tour-cta {
    background: var(--color-blush);
    color: var(--color-ink);
  }

  .studio-tour-cta:hover,
  .studio-tour-cta:active {
    background: var(--color-blush-soft);
  }

  .studio-tab-link[data-active='true'] {
    color: var(--color-ink);
  }

  .locations-track {
    position: relative;
    padding-inline: var(--loc-pad, 1rem);
    scroll-padding-inline: var(--loc-pad, 1rem);
  }

  .locations-slide {
    /* Y = none so slides are not page snap targets; X = center for the carousel */
    scroll-snap-align: none center;
    opacity: 0.55;
    transform: scale(0.82);
    transform-origin: center center;
    transition:
      opacity 0.22s ease-out,
      transform 0.22s ease-out;
  }

  .locations-slide[data-active='true'] {
    opacity: 1;
    transform: scale(1.08);
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .locations-slide {
      transition: none;
      transform: none;
      opacity: 1;
    }

    .locations-slide[data-active='true'] {
      transform: none;
    }
  }

  .studio-tour-modal:not([hidden]) {
    display: block;
  }

  .scrollbar-none {
    scrollbar-width: none;
  }

  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>

<style is:global>
  .studio-pano .psv-container {
    --psv-loader-color: #dfb4c4;
    background: #1a1214;
  }

  .studio-pano .psv-loader-container {
    background: #1a1214;
  }

  .studio-pano .psv-virtual-tour-arrow {
    filter: drop-shadow(0 2px 10px rgb(37 34 35 / 50%));
  }

  .studio-pano [data-pano-gyro-hint] {
    transition: opacity 0.5s ease;
  }

  .studio-pano [data-pano-gyro-hint][data-hidden='true'] {
    opacity: 0;
  }

  .tour-swipe-hint {
    position: absolute;
    inset: 0;
    z-index: 24;
    display: grid;
    place-items: center;
    pointer-events: none;
    background: rgb(26 18 20 / 32%);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s ease, visibility 0.18s ease;
  }

  .tour-swipe-hint.is-visible {
    opacity: 1;
    visibility: visible;
    transition: none;
  }

  .tour-swipe-hint__icon {
    width: 5.5rem;
    height: auto;
    color: var(--color-blush);
    filter: drop-shadow(0 2px 12px rgb(26 18 20 / 70%));
    animation: tour-swipe-nudge 0.7s ease-in-out infinite;
  }

  @keyframes tour-swipe-nudge {
    0%,
    100% {
      transform: translateX(-0.55rem);
    }
    50% {
      transform: translateX(0.55rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
