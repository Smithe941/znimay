---
import { t } from '../i18n/ui';
import { serviceBlocks } from '../data/services';

const uk = t('uk');
---

<section
  id="services"
  class="chapter chapter--ink chapter-pad snap-section flex flex-col text-blush-soft md:h-[100svh] md:h-[100dvh] md:overflow-hidden"
>
  <div class="mx-auto flex min-h-0 w-full max-w-6xl flex-1 flex-col">
    <div class="shrink-0 max-w-xl">
      <h2 class="chapter-title text-blush max-md:sr-only">
        {uk.services.title}
      </h2>
      <p class="chapter-lede text-blush-soft/75 max-md:mt-0">
        {uk.services.subtitle}
      </p>
    </div>

    <div
      class="mt-4 min-h-0 md:flex-1 md:overflow-y-auto md:overscroll-y-auto sm:mt-6 md:mt-8"
      data-services-scroll
    >
      <div class="space-y-10 pb-2 sm:space-y-12 md:space-y-16">
        {
          serviceBlocks.map((block) => (
            <div>
              <div class="max-w-xl">
                <h3 class="font-display text-[1.5rem] leading-none tracking-wide text-blush sm:text-3xl">
                  {block.title}
                </h3>
                <p class="mt-2 text-[0.875rem] leading-relaxed text-blush-soft/65 sm:text-[0.95rem]">
                  {block.lead}
                </p>
              </div>

              {block.items.length > 0 && (
                <ul class="mt-4 divide-y divide-blush/15 border-y border-blush/15 sm:mt-6">
                  {block.items.map((item) => (
                    <li class="grid gap-2 py-4 sm:grid-cols-[minmax(0,0.38fr)_minmax(0,0.62fr)] sm:gap-8 sm:py-5 md:gap-12">
                      <h4 class="font-display text-[1.25rem] leading-snug tracking-wide text-blush sm:text-[1.35rem]">
                        {item.title}
                      </h4>
                      <p class="text-[0.875rem] leading-relaxed text-blush-soft/80 sm:text-base">
                        {item.body}
                      </p>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>

      <div class="pt-8 pb-2 sm:pt-10 md:pt-12">
        <a
          href="#contact"
          class="inline-flex min-h-12 cursor-pointer items-center justify-center border border-blush/40 px-6 py-3.5 text-center text-xs tracking-[0.16em] uppercase text-blush transition hover:border-blush hover:bg-blush/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/60 focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:border-blush active:bg-blush/10 sm:min-h-0 sm:px-7 sm:py-3 sm:text-sm"
        >
          {uk.services.cta}
        </a>
      </div>
    </div>
  </div>
</section>
