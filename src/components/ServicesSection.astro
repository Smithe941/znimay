---
import { t } from '../i18n/ui';
import { serviceBlocks } from '../data/services';
import I18nText from './I18nText.astro';

const uk = t('uk');
const en = t('en');
---

<section
  id="services"
  class="chapter chapter--ink snap-section flex h-[100svh] h-[100dvh] flex-col overflow-hidden px-4 pt-[max(4rem,calc(env(safe-area-inset-top)+3.25rem))] pb-[max(1rem,env(safe-area-inset-bottom))] text-blush-soft sm:px-6 sm:pt-16 md:px-8 md:pt-[4.5rem]"
>
  <div class="mx-auto flex min-h-0 w-full max-w-6xl flex-1 flex-col">
    <div class="shrink-0 max-w-xl">
      <h2 class="font-display text-[2.35rem] leading-none text-blush sm:text-4xl md:text-5xl">
        <I18nText uk={uk.services.title} en={en.services.title} />
      </h2>
      <p class="mt-2 text-[0.95rem] leading-relaxed text-blush-soft/75 sm:mt-3 sm:text-base">
        <I18nText uk={uk.services.subtitle} en={en.services.subtitle} />
      </p>
    </div>

    <div
      class="mt-6 min-h-0 flex-1 overflow-y-auto overscroll-y-auto sm:mt-8"
      data-services-scroll
    >
      <div class="space-y-12 pb-2 sm:space-y-14 md:space-y-16">
        {
          serviceBlocks.map((block) => (
            <div>
              <div class="max-w-xl">
                <h3 class="font-display text-[1.65rem] leading-none tracking-wide text-blush sm:text-3xl">
                  <I18nText uk={block.title.uk} en={block.title.en} />
                </h3>
                <p class="mt-2 text-[0.9rem] leading-relaxed text-blush-soft/65 sm:text-[0.95rem]">
                  <I18nText uk={block.lead.uk} en={block.lead.en} />
                </p>
              </div>

              {block.items.length > 0 && (
                <ul class="mt-6 divide-y divide-blush/15 border-y border-blush/15 sm:mt-7">
                  {block.items.map((item) => (
                    <li class="grid gap-2 py-5 sm:grid-cols-[minmax(0,0.38fr)_minmax(0,0.62fr)] sm:gap-8 sm:py-6 md:gap-12">
                      <h4 class="font-display text-[1.25rem] leading-snug tracking-wide text-blush sm:text-[1.35rem]">
                        <I18nText uk={item.title.uk} en={item.title.en} />
                      </h4>
                      <p class="text-[0.95rem] leading-relaxed text-blush-soft/80 sm:text-base">
                        <I18nText uk={item.body.uk} en={item.body.en} />
                      </p>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>

      <div class="pt-8 pb-2 sm:pt-10">
        <a
          href="#contact"
          class="inline-flex min-h-12 cursor-pointer items-center justify-center border border-blush/40 px-6 py-3.5 text-center text-xs tracking-[0.16em] uppercase text-blush transition hover:border-blush hover:bg-blush/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/60 focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:border-blush active:bg-blush/10 sm:min-h-0 sm:px-7 sm:py-3 sm:text-sm sm:tracking-[0.14em]"
        >
          <I18nText uk={uk.services.cta} en={en.services.cta} />
        </a>
      </div>
    </div>
  </div>
</section>
