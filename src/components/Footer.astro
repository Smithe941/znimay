---
import { t } from '../i18n/ui';
import BrandLogo from './BrandLogo.astro';

interface Props {
  hideOnMobileApp?: boolean;
}

const { hideOnMobileApp = false } = Astro.props;
const uk = t('uk');
const year = new Date().getFullYear();
---

<footer
  class:list={[
    'chapter--ink border-t border-blush/10 text-blush-soft',
    hideOnMobileApp && 'max-md:hidden',
  ]}
>
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-8 pb-[max(2.5rem,env(safe-area-inset-bottom))] sm:px-6 md:flex-row md:items-center md:justify-between md:px-8 md:py-10"
  >
    <BrandLogo size="footer" variant="bare" />
    <p class="text-sm text-blush-soft/70">
      {year}. {uk.footer.rights}
    </p>
  </div>
</footer>
