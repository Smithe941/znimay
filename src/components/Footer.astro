---
import { t } from '../i18n/ui';
import BrandLogo from './BrandLogo.astro';
import I18nText from './I18nText.astro';

const uk = t('uk');
const en = t('en');
const year = new Date().getFullYear();
---

<footer class="chapter--ink border-t border-blush/10 text-blush-soft">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-5 px-4 py-8 pb-[max(2.5rem,env(safe-area-inset-bottom))] sm:px-6 md:flex-row md:items-center md:justify-between md:px-8 md:py-9"
  >
    <BrandLogo lang="uk" size="footer" variant="bare" />
    <p class="text-sm text-blush-soft/70">
      {year}. <I18nText uk={uk.footer.rights} en={en.footer.rights} />
    </p>
  </div>
</footer>
