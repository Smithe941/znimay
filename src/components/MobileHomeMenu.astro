---
import { t } from '../i18n/ui';
import BrandLogo from './BrandLogo.astro';
import HeroCarousel from './HeroCarousel.astro';

interface Props {
  images: string[];
}

const { images } = Astro.props;
const uk = t('uk');

const links = [
  { tab: 'portfolio', hash: '#team', label: uk.nav.team },
  { tab: 'offer', hash: '#pricing', label: uk.nav.servicesAndPricing },
] as const;
---

<div class="mobile-home-menu md:hidden" data-mobile-home-menu>
  <div class="mobile-home-menu__hero">
    <HeroCarousel images={images} />
    <div class="mobile-home-menu__hero-copy">
      <h1 class="mobile-home-menu__brand">
        <BrandLogo size="hero" variant="bare" />
      </h1>
      <p class="mobile-home-menu__tagline">
        {uk.hero.menuTagline}
      </p>
    </div>
  </div>

  <div class="mobile-home-menu__sheet">
    <nav class="mobile-home-menu__nav" aria-label={uk.nav.home}>
      {
        links.map((link) => (
          <a
            href={link.hash}
            class="mobile-home-menu__link"
            data-mobile-menu-link
            data-tab-target={link.tab}
          >
            {link.label}
            <span class="mobile-home-menu__chevron" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none">
                <path
                  d="M6 3l5 5-5 5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </a>
        ))
      }
      <a
        href="#tour"
        class="mobile-home-menu__link mobile-home-menu__link--tour"
        data-tour-launch
        aria-haspopup="dialog"
        aria-controls="studio-tour-modal"
      >
        <span class="mobile-home-menu__tour-copy">
          <span class="mobile-home-menu__tour-label">
            {uk.studio.tabTour}
          </span>
          <span class="mobile-home-menu__tour-hint">
            {uk.studio.tabTourHint}
          </span>
        </span>
        <span class="mobile-home-menu__tour-orb" aria-hidden="true">
          <span class="mobile-home-menu__tour-orb-core"></span>
        </span>
      </a>
    </nav>

    <div class="mobile-home-menu__social">
      <a
        class="mobile-home-menu__social-link mobile-home-menu__social-link--ig"
        href="https://www.instagram.com/znimay_phstudio/"
        target="_blank"
        rel="noreferrer"
      >
        <span class="mobile-home-menu__social-label">
          {uk.contact.instagramLabel}
        </span>
        <span>@znimay_phstudio</span>
      </a>
      <a
        class="mobile-home-menu__social-link mobile-home-menu__social-link--tg"
        href="https://t.me/znimay_bot"
        target="_blank"
        rel="noreferrer"
      >
        <span class="mobile-home-menu__social-label">
          {uk.contact.telegramLabel}
        </span>
        <span>@znimay_bot</span>
      </a>
    </div>
  </div>
</div>
