---
import { t } from '../i18n/ui';
import BrandLogo from './BrandLogo.astro';
import HeroCarousel from './HeroCarousel.astro';
import I18nText from './I18nText.astro';

interface Props {
  images: string[];
}

const { images } = Astro.props;
const uk = t('uk');
const en = t('en');

const links = [
  { tab: 'portfolio', hash: '#team', uk: uk.nav.team, en: en.nav.team },
  { tab: 'studio', hash: '#studio', uk: uk.nav.studio, en: en.nav.studio },
  { tab: 'offer', hash: '#pricing', uk: uk.nav.servicesAndPricing, en: en.nav.servicesAndPricing },
] as const;
---

<div class="mobile-home-menu md:hidden" data-mobile-home-menu>
  <div class="mobile-home-menu__hero">
    <HeroCarousel images={images} />
    <div class="mobile-home-menu__hero-copy">
      <h1 class="mobile-home-menu__brand">
        <BrandLogo lang="uk" size="hero" variant="bare" />
      </h1>
      <p class="mobile-home-menu__tagline">
        <I18nText uk={uk.hero.menuTagline} en={en.hero.menuTagline} />
      </p>
    </div>
  </div>

  <div class="mobile-home-menu__sheet">
    <nav class="mobile-home-menu__nav" aria-label={uk.nav.home}>
      {
        links.map((link) => (
          <a
            href={link.hash}
            class="mobile-home-menu__link"
            data-mobile-menu-link
            data-tab-target={link.tab}
          >
            <I18nText uk={link.uk} en={link.en} />
            <span class="mobile-home-menu__chevron" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none">
                <path
                  d="M6 3l5 5-5 5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </a>
        ))
      }
    </nav>

    <div class="mobile-home-menu__social">
      <a
        class="mobile-home-menu__social-link"
        href="https://t.me/znimay_bot"
        target="_blank"
        rel="noreferrer"
      >
        <span class="mobile-home-menu__social-label">
          <I18nText uk={uk.contact.telegramLabel} en={en.contact.telegramLabel} />
        </span>
        <span>@znimay_bot</span>
      </a>
      <a
        class="mobile-home-menu__social-link"
        href="https://www.instagram.com/znimay_phstudio/"
        target="_blank"
        rel="noreferrer"
      >
        <span class="mobile-home-menu__social-label">
          <I18nText uk={uk.contact.instagramLabel} en={en.contact.instagramLabel} />
        </span>
        <span>@znimay_phstudio</span>
      </a>
    </div>
  </div>
</div>
