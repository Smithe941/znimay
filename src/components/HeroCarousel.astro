---
interface Props {
  images: string[];
  intervalMs?: number;
}

const { images, intervalMs = 10000 } = Astro.props;
---

{
  images.length > 0 ? (
    <div
      class="hero-carousel relative h-full min-h-[44svh] w-full overflow-hidden bg-ink md:min-h-full"
      data-hero-carousel
      data-interval={intervalMs}
      aria-roledescription="carousel"
      aria-label="Studio"
    >
      {images.map((src, index) => (
        <figure
          class="hero-carousel__slide absolute inset-0 m-0"
          data-hero-slide
          data-active={index === 0 ? 'true' : 'false'}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <img
            src={src}
            alt=""
            class="hero-carousel__img h-full w-full object-cover"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            draggable="false"
          />
        </figure>
      ))}

      {images.length > 1 && (
        <div
          class="absolute bottom-5 left-1/2 z-20 flex -translate-x-1/2 items-center gap-2 md:bottom-8 md:left-auto md:right-8 md:translate-x-0"
          role="tablist"
          aria-label="Slides"
        >
          {images.map((_, index) => (
            <button
              type="button"
              class="hero-carousel__dot size-2 cursor-pointer rounded-full bg-surface/35 transition hover:bg-surface/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/60 focus-visible:ring-offset-2 focus-visible:ring-offset-ink"
              data-hero-dot={index}
              data-active={index === 0 ? 'true' : 'false'}
              aria-label={`Slide ${index + 1}`}
              aria-current={index === 0 ? 'true' : undefined}
            />
          ))}
        </div>
      )}
    </div>
  ) : (
    <div class="h-full min-h-[44svh] w-full bg-ink md:min-h-full" aria-hidden="true" />
  )
}

<style>
  .hero-carousel__slide {
    opacity: 0;
    transition: opacity 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 0;
  }

  .hero-carousel__slide[data-active='true'] {
    opacity: 1;
    z-index: 1;
  }

  .hero-carousel__img {
    transform: scale(1.16);
    transition: transform 22s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .hero-carousel__slide[data-active='true'] .hero-carousel__img {
    transform: scale(1);
  }

  .hero-carousel__dot[data-active='true'] {
    background: var(--color-blush);
    transform: scale(1.25);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-carousel__slide,
    .hero-carousel__img {
      transition: none;
    }

    .hero-carousel__img {
      transform: none;
    }
  }
</style>

<script>
  function initCarousel(root: HTMLElement) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    if (slides.length < 2) return;

    const intervalMs = Number(root.dataset.interval) || 10000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = slides.findIndex((slide) => slide.dataset.active === 'true');
    if (index < 0) index = 0;
    let timer = 0;
    let paused = false;

    function setActive(next: number) {
      index = ((next % slides.length) + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const on = i === index;
        slide.dataset.active = String(on);
        slide.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
      dots.forEach((dot, i) => {
        const on = i === index;
        dot.dataset.active = String(on);
        if (on) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    }

    function stop() {
      window.clearInterval(timer);
      timer = 0;
    }

    function start() {
      if (reduceMotion || paused || document.hidden) return;
      stop();
      timer = window.setInterval(() => setActive(index + 1), intervalMs);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const next = Number(dot.dataset.heroDot);
        if (Number.isNaN(next)) return;
        setActive(next);
        start();
      });
    });

    root.addEventListener('mouseenter', () => {
      paused = true;
      stop();
    });
    root.addEventListener('mouseleave', () => {
      paused = false;
      start();
    });
    root.addEventListener('focusin', () => {
      paused = true;
      stop();
    });
    root.addEventListener('focusout', () => {
      if (!root.contains(document.activeElement)) {
        paused = false;
        start();
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    start();
  }

  document.querySelectorAll<HTMLElement>('[data-hero-carousel]').forEach(initCarousel);
</script>
