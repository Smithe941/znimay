---
import { t } from '../i18n/ui';

const uk = t('uk');

const tabs = [
  { id: 'home', hash: '#', label: uk.nav.home, icon: 'home' },
  { id: 'portfolio', hash: '#team', label: uk.nav.team, icon: 'portfolio' },
  { id: 'studio', hash: '#studio', label: uk.nav.studio, icon: 'studio' },
  { id: 'offer', hash: '#pricing', label: uk.nav.servicesAndPricing, icon: 'offer' },
  { id: 'contact', hash: '#contact', label: uk.nav.contact, icon: 'contact' },
] as const;
---

<nav
  class="mobile-tabbar md:hidden"
  data-mobile-tabbar
  aria-label={uk.nav.primary}
>
  <div class="mobile-tabbar__inner" role="tablist">
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          class="mobile-tabbar__tab"
          data-mobile-tab={tab.id}
          data-hash={tab.hash}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
        >
          <span class="mobile-tabbar__icon" aria-hidden="true">
            {tab.icon === 'home' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" d="M5 7h14M5 12h14M5 17h10" />
              </svg>
            )}
            {tab.icon === 'portfolio' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="3.5" y="5.5" width="17" height="13" rx="1.5" />
                <path stroke-linecap="round" d="M3.5 15.5 8 12l3.5 3 3-2.5 6 4" />
                <circle cx="9" cy="9.5" r="1.25" fill="currentColor" stroke="none" />
              </svg>
            )}
            {tab.icon === 'studio' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4 19.5V6.75A1.75 1.75 0 0 1 5.75 5h5.5c.56 0 1.09.27 1.42.72L14 8h4.25A1.75 1.75 0 0 1 20 9.75V19.5"
                />
                <path stroke-linecap="round" d="M4 19.5h16" />
              </svg>
            )}
            {tab.icon === 'offer' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 7h11M8 12h11M8 17h7M5 7h.01M5 12h.01M5 17h.01"
                />
              </svg>
            )}
            {tab.icon === 'contact' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4.5 6.75A2.25 2.25 0 0 1 6.75 4.5h10.5a2.25 2.25 0 0 1 2.25 2.25v7.5a2.25 2.25 0 0 1-2.25 2.25H9.5L5.25 20v-3.5A2.25 2.25 0 0 1 4.5 14.25v-7.5Z"
                />
              </svg>
            )}
          </span>
          <span class="mobile-tabbar__label">
            {tab.label}
          </span>
        </button>
      ))
    }
  </div>
</nav>
