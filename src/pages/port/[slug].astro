---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import GalleryNav from '../../components/GalleryNav.astro';
import TeamPortrait from '../../components/TeamPortrait.astro';
import I18nText from '../../components/I18nText.astro';
import { t } from '../../i18n/ui';
import { team, getTeamMember, teamMonogram } from '../../data/team';
import { homePath, teamMemberPath } from '../../lib/paths';
import { fetchTeamGalleries, fetchTeamHero, imageUrl } from '../../lib/cloudinary';

export function getStaticPaths() {
  return team.map((member) => ({
    params: { slug: member.slug },
  }));
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect(homePath());
}

const member = getTeamMember(slug);
if (!member) {
  return Astro.redirect(homePath());
}

const uk = t('uk');
const en = t('en');
const [hero, rawGalleries] = await Promise.all([
  fetchTeamHero(member.folder),
  fetchTeamGalleries(member.folder),
]);

const galleries = rawGalleries.filter((gallery) => gallery.images.length > 0);
const hasWork = galleries.length > 0;
const heroUrl = hero ? imageUrl(hero.publicId, 'card') : null;
const monogram = teamMonogram(member.name.uk);
const others = team.filter((item) => item.slug !== member.slug);

const galleryLinks = galleries.map((gallery) => ({
  id: `gallery-${member.slug}-${gallery.orderKey}-${gallery.slug}`,
  title: gallery.title,
}));
---

<BaseLayout
  title={member.name}
  description={member.bio}
  ogImage={heroUrl ?? undefined}
  galleryPage
>
  <section class="mx-auto max-w-6xl px-4 pb-[max(5.5rem,calc(env(safe-area-inset-bottom)+4rem))] pt-[max(5.5rem,calc(env(safe-area-inset-top)+4rem))] sm:px-6 sm:pb-24 sm:pt-[max(5rem,calc(env(safe-area-inset-top)+3.75rem))] md:px-8">
    <div class="reveal flex items-start gap-3 sm:gap-4 md:items-center md:gap-5">
      <TeamPortrait
        src={heroUrl}
        alt={hero?.alt ?? member.name.uk}
        monogram={monogram}
        class="aspect-[3/4] w-14 shrink-0 sm:w-16 md:w-20"
        loading="eager"
        width={hero?.width}
        height={hero?.height}
      />

      <div class="min-w-0 flex-1">
        <a
          href={homePath()}
          class="inline-flex cursor-pointer items-center text-[0.65rem] tracking-[0.16em] uppercase text-muted transition hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-surface sm:text-xs"
        >
          ← <I18nText uk={uk.portfolio.back} en={en.portfolio.back} />
        </a>
        <h1 class="mt-1 font-display text-[1.85rem] leading-none tracking-wide sm:text-3xl md:text-4xl">
          <I18nText uk={member.name.uk} en={member.name.en} />
        </h1>
        <p class="mt-1.5 max-w-xl text-[0.85rem] leading-snug text-muted sm:mt-2 sm:text-[0.95rem] sm:leading-relaxed">
          <I18nText uk={member.bio.uk} en={member.bio.en} />
        </p>
      </div>
    </div>

    {
      hasWork ? (
        <div class="mt-4 sm:mt-8">
          <GalleryNav galleries={galleryLinks} label={uk.portfolio.galleriesNav} />

          <div class="mt-3 sm:mt-8">
            {galleries.map((gallery, index) => {
              const id = galleryLinks[index].id;
              const active = index === 0;
              return (
                <div
                  id={id}
                  role="tabpanel"
                  aria-labelledby={`${id}-tab`}
                  class:list={[!active && 'hidden']}
                  hidden={!active}
                  data-gallery-panel={id}
                >
                  <h2 class="sr-only">{gallery.title}</h2>
                  <Gallery
                    id={`${member.slug}-${gallery.orderKey}-${gallery.slug}`}
                    images={gallery.images}
                    emptyLabel={uk.portfolio.empty}
                    loadMedia={active}
                  />
                </div>
              );
            })}
          </div>
        </div>
      ) : (
        <div class="reveal relative mt-10 overflow-hidden border-t border-ink/10 pt-8 sm:mt-12 sm:pt-10">
          <div
            class="pointer-events-none absolute -right-8 top-4 select-none font-display text-[clamp(5rem,22vw,10rem)] leading-none text-blush/15"
            aria-hidden="true"
          >
            {monogram}
          </div>
          <h2 class="relative font-display text-2xl sm:text-3xl md:text-4xl">
            <I18nText uk={uk.portfolio.emptyTitle} en={en.portfolio.emptyTitle} />
          </h2>
          <p class="relative mt-3 max-w-xl text-[0.95rem] leading-relaxed text-muted sm:mt-4 sm:text-base">
            <I18nText uk={uk.portfolio.emptyBody} en={en.portfolio.emptyBody} />
          </p>
          <a
            href="https://www.instagram.com/znimay_phstudio/"
            target="_blank"
            rel="noopener noreferrer"
            class="relative mt-6 inline-flex min-h-11 cursor-pointer items-center gap-3 text-sm tracking-[0.14em] uppercase text-ink transition hover:text-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
          >
            <span>
              <I18nText uk={uk.portfolio.emptyCta} en={en.portfolio.emptyCta} />
            </span>
            <span class="text-blush">@znimay_phstudio</span>
          </a>
        </div>
      )
    }

    {
      others.length > 0 && (
        <div class="reveal mt-14 border-t border-ink/10 pt-10 sm:mt-20 sm:pt-12">
          <p class="mb-5 text-xs tracking-[0.18em] uppercase text-muted">
            <I18nText uk={uk.portfolio.otherMembers} en={en.portfolio.otherMembers} />
          </p>
          <ul class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-x-10 sm:gap-y-3">
            {others.map((item) => (
              <li>
                <a
                  href={teamMemberPath(item.slug)}
                  class="group inline-flex cursor-pointer items-baseline gap-3 font-display text-xl tracking-wide transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-surface sm:text-2xl"
                >
                  <span class="text-ink group-hover:text-muted">
                    <I18nText uk={item.name.uk} en={item.name.en} />
                  </span>
                  <span class="text-xs tracking-[0.16em] uppercase text-blush">
                    <I18nText uk={uk.team.viewPortfolio} en={en.team.viewPortfolio} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>
</BaseLayout>
