---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';
import { homePath } from '../lib/paths';
---

<BaseLayout title={ui.notFound.title} description={ui.notFound.body}>
  <section class="chapter-pad chapter-pad--page mx-auto flex min-h-[70svh] max-w-6xl flex-col justify-center">
    <p class="text-[0.65rem] tracking-[0.16em] uppercase text-muted">404</p>
    <h1 class="mt-3 font-display text-[2rem] leading-none tracking-wide sm:text-4xl md:text-5xl">
      {ui.notFound.title}
    </h1>
    <p class="chapter-lede mt-4 max-w-md text-muted">
      {ui.notFound.body}
    </p>
    <a
      href={homePath()}
      class="mt-8 inline-flex min-h-12 w-fit cursor-pointer items-center justify-center bg-ink px-6 py-3.5 text-center text-xs tracking-[0.16em] uppercase text-blush transition hover:bg-ink/90 hover:text-blush-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/30 focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
    >
      {ui.notFound.cta}
    </a>
  </section>
</BaseLayout>
