---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamSection from '../components/TeamSection.astro';
import StudioSpaces from '../components/StudioSpaces.astro';
import Pricing from '../components/Pricing.astro';
import ServicesSection from '../components/ServicesSection.astro';
import BrandLogo from '../components/BrandLogo.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import I18nText from '../components/I18nText.astro';
import { t } from '../i18n/ui';
import { listHeroImages } from '../lib/hero-media';

const uk = t('uk');
const en = t('en');
const base = import.meta.env.BASE_URL;
const heroImages = listHeroImages(base);
---

<BaseLayout swapLogoAfterHero structuredData>
  <div class="page-canvas">
    <section class="chapter chapter--ink snap-section relative overflow-hidden">
      <div
        class="grid min-h-[100svh] min-h-[100dvh] w-full md:grid-cols-[minmax(0,0.95fr)_minmax(0,1.15fr)] md:items-stretch lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.2fr)]"
      >
        <div
          class="relative z-10 flex flex-col justify-end px-4 pb-8 pt-[max(5.5rem,calc(env(safe-area-inset-top)+4.5rem))] sm:px-6 sm:pb-12 md:justify-center md:px-8 md:pb-20 md:pt-28 lg:px-10 lg:pr-4 xl:px-12"
        >
          <h1 id="hero-brand" class="reveal">
            <BrandLogo lang="uk" size="hero" variant="bare" />
          </h1>
          <p
            class="reveal mt-4 max-w-[20rem] text-[1.05rem] leading-snug text-blush-soft/90 sm:mt-5 sm:max-w-md sm:text-lg md:mt-6 md:text-xl"
            style="transition-delay: 80ms"
          >
            <I18nText uk={uk.hero.tagline} en={en.hero.tagline} />
          </p>
          <div
            class="reveal mt-8 flex w-full flex-col gap-3 sm:mt-9 sm:w-auto sm:flex-row sm:flex-wrap sm:gap-4"
            style="transition-delay: 140ms"
          >
            <a
              href="#team"
              class="inline-flex min-h-12 cursor-pointer items-center justify-center bg-blush px-6 py-3.5 text-center text-xs tracking-[0.16em] uppercase text-ink transition hover:bg-blush-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:bg-blush-soft sm:min-h-0 sm:px-7 sm:py-3 sm:text-sm sm:tracking-[0.14em]"
            >
              <I18nText uk={uk.hero.ctaTeam} en={en.hero.ctaTeam} />
            </a>
            <a
              href="#contact"
              class="inline-flex min-h-12 cursor-pointer items-center justify-center border border-blush/40 px-6 py-3.5 text-center text-xs tracking-[0.16em] uppercase text-blush transition hover:border-blush hover:bg-blush/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/60 focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:border-blush active:bg-blush/10 sm:min-h-0 sm:px-7 sm:py-3 sm:text-sm sm:tracking-[0.14em]"
            >
              <I18nText uk={uk.hero.ctaContact} en={en.hero.ctaContact} />
            </a>
          </div>
          <div
            class="reveal mt-6 flex flex-col gap-3 sm:mt-7 sm:flex-row sm:flex-wrap sm:gap-x-6 sm:gap-y-3"
            style="transition-delay: 200ms"
          >
            <a
              class="group inline-flex min-h-11 cursor-pointer items-center gap-2.5 text-blush transition hover:text-blush-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/50 focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:opacity-70"
              href="https://t.me/znimay_bot"
              target="_blank"
              rel="noreferrer"
            >
              <span
                class="flex size-9 shrink-0 items-center justify-center border border-blush/35 text-blush transition group-hover:border-blush group-hover:bg-blush/10"
                aria-hidden="true"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
                  />
                </svg>
              </span>
              <span class="flex min-w-0 flex-col gap-0.5 leading-none">
                <span class="text-[0.6rem] tracking-[0.16em] uppercase text-blush-soft/50">
                  <I18nText uk={uk.contact.telegramLabel} en={en.contact.telegramLabel} />
                </span>
                <span class="mt-1 text-sm">@znimay_bot</span>
              </span>
            </a>
            <a
              class="group inline-flex min-h-11 cursor-pointer items-center gap-2.5 text-blush transition hover:text-blush-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/50 focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:opacity-70"
              href="https://www.instagram.com/znimay_phstudio/"
              target="_blank"
              rel="noreferrer"
            >
              <span
                class="flex size-9 shrink-0 items-center justify-center border border-blush/35 text-blush transition group-hover:border-blush group-hover:bg-blush/10"
                aria-hidden="true"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
              </span>
              <span class="flex min-w-0 flex-col gap-0.5 leading-none">
                <span class="text-[0.6rem] tracking-[0.16em] uppercase text-blush-soft/50">
                  <I18nText uk={uk.contact.instagramLabel} en={en.contact.instagramLabel} />
                </span>
                <span class="mt-1 text-sm">@znimay_phstudio</span>
              </span>
            </a>
          </div>
        </div>

        <div class="relative min-h-[44svh] w-full md:min-h-full">
          <div class="h-full min-h-[44svh] w-full md:absolute md:inset-0 md:min-h-full">
            <HeroCarousel images={heroImages} />
          </div>
        </div>
      </div>
    </section>

    <TeamSection />

    <StudioSpaces />

    <ServicesSection />

    <Pricing />

    <section
      id="contact"
      class="chapter chapter--ink snap-section px-4 pt-12 pb-14 text-blush-soft sm:px-6 sm:pt-14 sm:pb-16 md:px-8 md:pt-16 md:pb-20"
    >
      <div class="reveal mx-auto max-w-6xl">
        <h2 class="font-display text-[2.35rem] leading-none text-blush sm:text-4xl md:text-5xl">
          <I18nText uk={uk.contact.title} en={en.contact.title} />
        </h2>
        <p class="mt-2 max-w-md text-[0.95rem] leading-relaxed text-blush-soft/75 sm:mt-3 sm:text-base">
          <I18nText uk={uk.contact.subtitle} en={en.contact.subtitle} />
        </p>
        <div class="mt-6 flex flex-col gap-4 sm:mt-8 sm:gap-5">
          <a
            class="group inline-flex min-h-12 cursor-pointer items-center gap-3 text-lg text-blush transition hover:text-blush-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/50 focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:opacity-70 sm:gap-3.5 sm:text-xl"
            href="https://t.me/znimay_bot"
            target="_blank"
            rel="noreferrer"
          >
            <span
              class="flex size-10 shrink-0 items-center justify-center border border-blush/35 text-blush transition group-hover:border-blush group-hover:bg-blush/10 sm:size-11"
              aria-hidden="true"
            >
              <svg class="size-5" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
                />
              </svg>
            </span>
            <span class="flex min-w-0 flex-col gap-0.5">
              <span class="text-[0.65rem] tracking-[0.16em] uppercase text-blush-soft/50">
                <I18nText uk={uk.contact.telegramLabel} en={en.contact.telegramLabel} />
              </span>
              <span>@znimay_bot</span>
            </span>
          </a>
          <a
            class="group inline-flex min-h-12 cursor-pointer items-center gap-3 text-lg text-blush transition hover:text-blush-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/50 focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:opacity-70 sm:gap-3.5 sm:text-xl"
            href="https://www.instagram.com/znimay_phstudio/"
            target="_blank"
            rel="noreferrer"
          >
            <span
              class="flex size-10 shrink-0 items-center justify-center border border-blush/35 text-blush transition group-hover:border-blush group-hover:bg-blush/10 sm:size-11"
              aria-hidden="true"
            >
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            </span>
            <span class="flex min-w-0 flex-col gap-0.5">
              <span class="text-[0.65rem] tracking-[0.16em] uppercase text-blush-soft/50">
                <I18nText uk={uk.contact.instagramLabel} en={en.contact.instagramLabel} />
              </span>
              <span>@znimay_phstudio</span>
            </span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
