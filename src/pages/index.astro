---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamSection from '../components/TeamSection.astro';
import StudioSpaces from '../components/StudioSpaces.astro';
import Pricing from '../components/Pricing.astro';
import ServicesSection from '../components/ServicesSection.astro';
import MobileTabBar from '../components/MobileTabBar.astro';
import MobileHomeMenu from '../components/MobileHomeMenu.astro';
import BrandLogo from '../components/BrandLogo.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import { t } from '../i18n/ui';
import { listHeroImages } from '../lib/hero-media';
import { studioPlace } from '../data/contact';
import StudioMap from '../components/StudioMap.astro';

const uk = t('uk');
const base = import.meta.env.BASE_URL;
const heroImages = listHeroImages(base);
---

<BaseLayout swapLogoAfterHero structuredData mobileApp>
  <div class="page-canvas" data-app-root>
    <section
      id="hero"
      data-tab="home"
      class="chapter chapter--ink snap-section relative overflow-hidden is-tab-active"
    >
      <!-- Mobile: menu hub (not a long landing) -->
      <MobileHomeMenu images={heroImages} />

      <!-- Desktop: full hero -->
      <div
        class="hidden min-h-[100svh] min-h-[100dvh] w-full md:grid md:grid-cols-[minmax(0,0.95fr)_minmax(0,1.15fr)] md:items-stretch lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.2fr)]"
      >
        <div
          class="relative z-10 flex flex-col justify-center px-8 pb-20 pt-28 lg:px-10"
        >
          <p id="hero-brand" class="reveal">
            <BrandLogo size="hero" variant="bare" />
          </p>
          <p
            class="reveal mt-6 max-w-md text-lg leading-snug text-blush-soft/90 md:text-xl"
            style="transition-delay: 80ms"
          >
            {uk.hero.tagline}
          </p>
          <div
            class="reveal mt-8 flex w-auto flex-row flex-wrap gap-4"
            style="transition-delay: 140ms"
          >
            <a
              href="#team"
              class="inline-flex cursor-pointer items-center justify-center bg-blush px-7 py-3 text-center text-sm tracking-[0.16em] uppercase text-ink transition hover:bg-blush-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:bg-blush-soft"
            >
              {uk.hero.ctaTeam}
            </a>
            <a
              href="#contact"
              class="inline-flex cursor-pointer items-center justify-center border border-blush/40 px-7 py-3 text-center text-sm tracking-[0.16em] uppercase text-blush transition hover:border-blush hover:bg-blush/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/60 focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:border-blush active:bg-blush/10"
            >
              {uk.hero.ctaContact}
            </a>
          </div>
          <div
            class="reveal mt-8 flex flex-row flex-wrap gap-x-8 gap-y-4"
            style="transition-delay: 200ms"
          >
            <a
              class="group inline-flex min-h-11 cursor-pointer items-center gap-2.5 text-blush transition hover:text-blush-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/50 focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:opacity-70"
              href="https://t.me/znimay_bot"
              target="_blank"
              rel="noreferrer"
            >
              <span
                class="flex size-9 shrink-0 items-center justify-center border border-blush/35 text-blush transition group-hover:border-blush group-hover:bg-blush/10"
                aria-hidden="true"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
                  />
                </svg>
              </span>
              <span class="flex min-w-0 flex-col gap-0.5 leading-none">
                <span class="text-[0.65rem] tracking-[0.16em] uppercase text-blush-soft/50">
                  {uk.contact.telegramLabel}
                </span>
                <span class="mt-1 text-sm">@znimay_bot</span>
              </span>
            </a>
            <a
              class="group inline-flex min-h-11 cursor-pointer items-center gap-2.5 text-blush transition hover:text-blush-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/50 focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:opacity-70"
              href="https://www.instagram.com/znimay_phstudio/"
              target="_blank"
              rel="noreferrer"
            >
              <span
                class="flex size-9 shrink-0 items-center justify-center border border-blush/35 text-blush transition group-hover:border-blush group-hover:bg-blush/10"
                aria-hidden="true"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
              </span>
              <span class="flex min-w-0 flex-col gap-0.5 leading-none">
                <span class="text-[0.65rem] tracking-[0.16em] uppercase text-blush-soft/50">
                  {uk.contact.instagramLabel}
                </span>
                <span class="mt-1 text-sm">@znimay_phstudio</span>
              </span>
            </a>
          </div>
        </div>

        <div class="relative min-h-[44svh] w-full md:min-h-full">
          <div class="h-full min-h-[44svh] w-full md:absolute md:inset-0 md:min-h-full">
            <HeroCarousel images={heroImages} />
          </div>
        </div>
      </div>
    </section>

    <TeamSection />

    <StudioSpaces />

    <div class="offer-stack" data-tab="offer" data-offer-stack>
      <div class="offer-mobile-chrome md:hidden">
        <div
          class="offer-mobile-tabs flex gap-6 border-b border-blush/20"
          role="tablist"
          aria-label={uk.nav.servicesAndPricing}
          data-offer-tabs
        >
          <button
            type="button"
            role="tab"
            class="offer-mobile-tab"
            data-offer-tab="pricing"
            aria-selected="true"
            data-active="true"
            tabindex="0"
          >
            {uk.nav.pricing}
          </button>
          <button
            type="button"
            role="tab"
            class="offer-mobile-tab"
            data-offer-tab="services"
            aria-selected="false"
            data-active="false"
            tabindex="-1"
          >
            {uk.nav.services}
          </button>
        </div>
      </div>

      <div class="offer-panel contents" data-offer-panel="services">
        <ServicesSection />
      </div>
      <div class="offer-panel contents" data-offer-panel="pricing">
        <Pricing />
      </div>
    </div>

    <section
      id="contact"
      data-tab="contact"
      class="chapter chapter--ink chapter-pad chapter-pad--roomy snap-section flex flex-col text-blush-soft"
    >
      <div class="reveal mx-auto flex min-h-0 w-full max-w-6xl flex-1 flex-col gap-6 sm:gap-8 md:flex-row md:items-start md:gap-12 lg:gap-16">
        <div class="shrink-0 md:w-[min(100%,22rem)] lg:w-[26rem]" data-contact-info>
          <h2 class="chapter-title text-blush">
            {uk.contact.title}
          </h2>
          <p class="chapter-lede max-w-md text-blush-soft/75">
            {uk.contact.subtitle}
          </p>
          <div class="mt-4 flex flex-col gap-3 sm:mt-6 md:mt-8 sm:gap-4">
            <a
              class="group inline-flex min-h-11 cursor-pointer items-center gap-2.5 text-base text-blush transition hover:text-blush-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/50 focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:opacity-70 sm:min-h-12 sm:gap-3.5 sm:text-xl"
              href={studioPlace.mapsUrl}
              target="_blank"
              rel="noreferrer"
            >
              <span
                class="flex size-9 shrink-0 items-center justify-center border border-blush/35 text-blush transition group-hover:border-blush group-hover:bg-blush/10 sm:size-11"
                aria-hidden="true"
              >
                <svg class="size-4 sm:size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" />
                  <circle cx="12" cy="10" r="2.25" />
                </svg>
              </span>
              <span class="flex min-w-0 flex-col gap-0.5 leading-none">
                <span class="text-[0.65rem] tracking-[0.16em] uppercase text-blush-soft/50">
                  {uk.contact.addressLabel}
                </span>
                <span class="mt-1">
                  {`${studioPlace.street}, ${studioPlace.city}`}
                </span>
              </span>
            </a>
            <a
              class="group inline-flex min-h-11 cursor-pointer items-center gap-2.5 text-base text-blush transition hover:text-blush-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/50 focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:opacity-70 sm:min-h-12 sm:gap-3.5 sm:text-xl"
              href="https://t.me/znimay_bot"
              target="_blank"
              rel="noreferrer"
            >
              <span
                class="flex size-9 shrink-0 items-center justify-center border border-blush/35 text-blush transition group-hover:border-blush group-hover:bg-blush/10 sm:size-11"
                aria-hidden="true"
              >
                <svg class="size-4 sm:size-5" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
                  />
                </svg>
              </span>
              <span class="flex min-w-0 flex-col gap-0.5 leading-none">
                <span class="text-[0.65rem] tracking-[0.16em] uppercase text-blush-soft/50">
                  {uk.contact.telegramLabel}
                </span>
                <span class="mt-1">@znimay_bot</span>
              </span>
            </a>
            <a
              class="group inline-flex min-h-11 cursor-pointer items-center gap-2.5 text-base text-blush transition hover:text-blush-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blush/50 focus-visible:ring-offset-2 focus-visible:ring-offset-ink active:opacity-70 sm:min-h-12 sm:gap-3.5 sm:text-xl"
              href="https://www.instagram.com/znimay_phstudio/"
              target="_blank"
              rel="noreferrer"
            >
              <span
                class="flex size-9 shrink-0 items-center justify-center border border-blush/35 text-blush transition group-hover:border-blush group-hover:bg-blush/10 sm:size-11"
                aria-hidden="true"
              >
                <svg class="size-4 sm:size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
              </span>
              <span class="flex min-w-0 flex-col gap-0.5 leading-none">
                <span class="text-[0.65rem] tracking-[0.16em] uppercase text-blush-soft/50">
                  {uk.contact.instagramLabel}
                </span>
                <span class="mt-1">@znimay_phstudio</span>
              </span>
            </a>
          </div>
        </div>

        <div class="flex min-h-0 w-full flex-1 flex-col md:max-w-none" data-contact-map>
          <StudioMap title={uk.contact.mapTitle} />
          <a
            href={studioPlace.mapsUrl}
            target="_blank"
            rel="noreferrer"
            class="mt-2 shrink-0 self-start text-[0.65rem] tracking-[0.16em] uppercase text-blush/70 transition hover:text-blush"
          >
            {uk.contact.openMap}
          </a>
        </div>
      </div>
    </section>
  </div>

  <MobileTabBar />
</BaseLayout>
