# Cloudinary API credentials
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_BASE_FOLDER=znimay

# Optional: Google Maps JS API — dark map in Contacts.
# Enable “Maps JavaScript API”, restrict the key to znimay.art/* and localhost:4321/*.
# https://console.cloud.google.com/google/maps-apis
# PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: only if previewing a project-Pages subdirectory locally.
# Custom domain (znimay.art) uses base /.
# PUBLIC_BASE_PATH=/
